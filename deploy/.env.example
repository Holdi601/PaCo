# Copy to deploy/.env and adjust. deploy/.env is git-ignored – never commit it.

# Public HTTPS address as reached from the children's PCs (including port).
PACO_PUBLIC_URL=https://example.duckdns.org:8790

# Host port (forward this TCP port in your router to the server).
PACO_PORT=8790

# Directory on the host with the Let's Encrypt PEM files (e.g. written by acme.sh).
PACO_TLS_DIR=/path/to/tls
PACO_TLS_CERT=fullchain.pem
PACO_TLS_KEY=key.pem

# Persistent data: database, signing key, data-protection keys. BACK THIS UP (not to Git!).
PACO_DATA_DIR=/path/to/paco-data

# UID/GID that owns PACO_DATA_DIR and can read the TLS files.
PACO_UID=1000
PACO_GID=1000

PACO_TZ=Europe/Berlin

# --- Push notifications (ntfy) ---
# Public HTTPS address parents subscribe to (forward this port in the router, same certificate as above).
PACO_NTFY_PUBLIC_URL=https://example.duckdns.org:8792
PACO_NTFY_PORT=8792
# ntfy data (user/token database, message cache).
PACO_NTFY_DIR=/path/to/paco-ntfy
# Publish token for PaCo, created once with:
#   docker exec paco-ntfy ntfy user add --role=admin paco    (password prompt)
#   docker exec paco-ntfy ntfy token add paco
PACO_NTFY_TOKEN=tk_replace_me

# Master key – keeps all stored secrets encrypted. Generate: openssl rand -base64 32 (also keep it in a password manager)
PACO_MASTER_KEY=

# --- Optional: LAN watcher (warns when a PC is on in THIS server's network but PaCo on it is silent) ---
# Only useful if children's PCs are (sometimes) in the same network as the server. To enable:
#   PACO_LAN_TOKEN=$(openssl rand -hex 32)   and   COMPOSE_PROFILES=lan
PACO_LAN_TOKEN=
# COMPOSE_PROFILES=lan
# Network interface to scan (default: the one with the default route).
# PACO_LAN_INTERFACE=eth0

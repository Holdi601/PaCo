# Copy to deploy/.env and adjust. deploy/.env is git-ignored – never commit it.

# Public HTTPS address as reached from the children's PCs (including port).
PACO_PUBLIC_URL=https://example.duckdns.org:8790

# Host port (forward this TCP port in your router to the server).
PACO_PORT=8790

# Directory on the host with the Let's Encrypt PEM files (e.g. written by acme.sh).
PACO_TLS_DIR=/path/to/tls
PACO_TLS_CERT=fullchain.pem
PACO_TLS_KEY=key.pem

# Persistent data: database, signing key, data-protection keys. BACK THIS UP (not to Git!).
PACO_DATA_DIR=/path/to/paco-data

# UID/GID that owns PACO_DATA_DIR and can read the TLS files.
PACO_UID=1000
PACO_GID=1000

PACO_TZ=Europe/Berlin

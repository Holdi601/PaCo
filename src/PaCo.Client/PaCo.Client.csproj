<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK projection for Windows.Devices.Geolocation (device location). Still runs on Windows 10 1809+. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- UI Automation (System.Windows.Automation) for reading visible window text for alarms. -->
    <UseWPF>true</UseWPF>
    <AssemblyName>PaCo</AssemblyName>
    <RootNamespace>PaCo.Client</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Allows building the Windows client inside the Linux Docker build. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Single self-contained exe: the child's PC needs no .NET installation. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaCo.Shared\PaCo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI translations client.{lang}.json (WithCulture=false: ".de" is not a satellite culture here). -->
    <EmbeddedResource Include="I18n\*.json" WithCulture="false" LogicalName="PaCo.Client.I18n.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.15" />
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="10.0.15" />
    <PackageReference Include="System.Management" Version="10.0.15" />
  </ItemGroup>

</Project>

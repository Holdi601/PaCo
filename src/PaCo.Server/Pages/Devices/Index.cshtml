@page
@model PaCo.Server.Pages.Devices.IndexModel
@{ ViewData["Title"] = "Geräte"; }

<h1 class="h3 mb-3">Geräte</h1>

<div class="card mb-4">
    <div class="card-header">Neues Gerät hinzufügen</div>
    <div class="card-body">
        <ol class="mb-3">
            <li>Auf dem PC des Kindes mit dem <strong>Administrator-Konto</strong> (nicht dem Kinderkonto) anmelden.</li>
            <li>Diese Seite dort öffnen und das Installationsprogramm herunterladen – oder die Datei per USB-Stick übertragen.</li>
            <li><strong>PaCo-Setup.exe</strong> starten. Falls Windows „Der Computer wurde durch Windows geschützt“ meldet: <em>Weitere Informationen → Trotzdem ausführen</em>.</li>
            <li>Die Windows-Konten der Kinder ankreuzen – fertig.</li>
        </ol>
        @if (Model.ClientAvailable)
        {
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <form method="post" asp-page-handler="Download">
                    <button class="btn btn-primary btn-lg">Installationsprogramm herunterladen</button>
                </form>
                <form method="post" asp-page-handler="Code">
                    <button class="btn btn-link">Code für manuelle Eingabe anzeigen</button>
                </form>
            </div>
            <div class="form-text">Version @(Model.ClientVersion ?? "unbekannt"). Jeder Download enthält einen eigenen Kopplungscode, gültig 24 Stunden und nur für ein Gerät.</div>
        }
        else
        {
            <div class="alert alert-warning mb-0">Das Installationsprogramm ist auf dem Server noch nicht vorhanden.</div>
        }
        @if (Model.ManualCode is not null)
        {
            <div class="alert alert-info mt-3 mb-0">
                <div>Serveradresse: <code>@Model.ServerUrl</code></div>
                <div>Kopplungscode (24 h gültig): <span class="code-box">@Model.ManualCode</span></div>
            </div>
        }
    </div>
</div>

@foreach (var d in Model.Devices)
{
    var online = d.IsOnline(Model.Now);
    <div class="card mb-3 @(d.Revoked ? "opacity-75" : "")">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <span class="fs-5">💻 @d.Name</span>
                @if (d.Revoked) { <span class="badge bg-secondary ms-2">entfernt</span> }
                else if (online) { <span class="badge bg-success ms-2">online</span> }
                else { <span class="badge bg-light text-dark ms-2">offline</span> }
            </div>
            <div class="small text-muted fw-normal">
                Zuletzt gemeldet: @Format.Ago(d.LastSeenUtc, Model.Now) · PaCo @d.ClientVersion · @d.OsVersion
            </div>
        </div>
        <div class="card-body">
            @if (!d.Revoked && Model.UpdateAvailable(d))
            {
                <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                    @if (d.UpdateRequested)
                    {
                        <span>⏳ Update auf Version @Model.ClientVersion wird beim nächsten Kontakt installiert …</span>
                    }
                    else
                    {
                        <span>Neue PaCo-Version @Model.ClientVersion verfügbar (installiert: @(d.ClientVersion ?? "?")).</span>
                        <form method="post" asp-page-handler="Update">
                            <input type="hidden" name="deviceId" value="@d.Id" />
                            <button class="btn btn-sm btn-primary">Update installieren</button>
                        </form>
                    }
                </div>
            }
            @if (!d.Revoked)
            {
                <h3 class="h6">Windows-Konten</h3>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Konto</th><th>Gehört zu</th></tr></thead>
                        <tbody>
                            @foreach (var a in d.Accounts.OrderBy(a => a.UserName))
                            {
                                <tr>
                                    <td>
                                        <div>@a.UserName @if (!string.IsNullOrWhiteSpace(a.FullName) && a.FullName != a.UserName) { <span class="text-muted small">(@a.FullName)</span> }</div>
                                        @if (a.IsAdmin)
                                        {
                                            <div class="small @(a.ChildId is null ? "text-muted" : "text-danger fw-semibold")">
                                                @(a.ChildId is null ? "Administrator" : "⚠ Administrator – Kinderkonten müssen Standardkonten sein!")
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="Assign" class="d-flex gap-2">
                                            <input type="hidden" name="accountId" value="@a.Id" />
                                            <select name="childId" class="form-select form-select-sm">
                                                <option value="">— nicht überwacht (Erwachsene) —</option>
                                                @foreach (var c in Model.Children)
                                                {
                                                    <option value="@c.Id" selected="@(a.ChildId == c.Id)">@c.Name</option>
                                                }
                                            </select>
                                            <button class="btn btn-sm btn-outline-primary">Speichern</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <form method="post" asp-page-handler="Rename" class="d-flex gap-2">
                        <input type="hidden" name="deviceId" value="@d.Id" />
                        <input name="name" value="@d.Name" class="form-control form-control-sm" aria-label="Gerätename" maxlength="100" />
                        <button class="btn btn-sm btn-outline-secondary text-nowrap">Umbenennen</button>
                    </form>
                    <form method="post" asp-page-handler="Revoke">
                        <input type="hidden" name="deviceId" value="@d.Id" />
                        <button class="btn btn-sm btn-outline-danger" data-confirm="@d.Name wirklich entfernen? Alle Sperren auf diesem PC werden aufgehoben.">Gerät entfernen</button>
                    </form>
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="deviceId" value="@d.Id" />
                    <button class="btn btn-sm btn-outline-secondary" data-confirm="Gerät und seine Statistik endgültig löschen?">Endgültig löschen</button>
                </form>
            }
        </div>
    </div>
}

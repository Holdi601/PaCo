@page
@model PaCo.Server.Pages.Devices.IndexModel
@{
    ViewData["Title"] = T("Geräte");
    var hasDevices = Model.Devices.Any(d => !d.Revoked);
}

<div class="page-head">
    <div class="page-head-main">
        <span class="page-icon" aria-hidden="true"><span class="ico ico-laptop" aria-hidden="true"></span></span>
        <div class="min-w-0">
            <h1 class="h3 page-title mb-1">@T("Geräte")</h1>
            <p class="text-muted mb-0">@T("Die PCs, auf denen PaCo läuft – und welches Windows-Konto zu welchem Kind gehört.")</p>
        </div>
    </div>
</div>

<div class="d-flex flex-column">
<details class="card mb-4 @(hasDevices ? "order-last" : "order-first")" open="@(!hasDevices || Model.ManualCode is not null)">
    <summary class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-plus" aria-hidden="true"></span></span>
        @if (hasDevices) { <span>@T("Weiteren PC hinzufügen")</span> } else { <span>@T("PC des Kindes hinzufügen")</span> }
    </summary>
    <div class="card-body">
        @if (!hasDevices)
        {
            <div class="add-device-art"><partial name="_ArtNoDevices" /></div>
        }
        <ol class="steps mb-4">
            <li>@Html.Raw(T("Auf dem PC des Kindes mit dem <strong>Administrator-Konto</strong> (nicht dem Kinderkonto) anmelden."))</li>
            <li>@Html.Raw(F("Diese Seite <strong>dort</strong> im Browser öffnen ({0}) und das Installationsprogramm herunterladen – oder die Datei per USB-Stick übertragen.", "<code>" + Html.Encode(Model.ServerUrl) + "</code>"))</li>
            <li>@Html.Raw(T("<strong>PaCo-Setup.exe</strong> starten. Falls Windows „Der Computer wurde durch Windows geschützt“ meldet: <em>Weitere Informationen → Trotzdem ausführen</em>."))</li>
            <li>@T("Die Windows-Konten der Kinder ankreuzen – fertig. Der PC erscheint dann hier.")</li>
        </ol>
        <p class="small text-muted d-md-none">@T("Du bist gerade am Handy? Das Installationsprogramm läuft nur unter Windows – öffne diese Seite am besten direkt auf dem Kinder-PC.")</p>
        @if (Model.ClientAvailable)
        {
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <form method="post" asp-page-handler="Download">
                    <button class="btn btn-primary btn-lg"><span class="ico ico-download" aria-hidden="true"></span>@T("Installationsprogramm herunterladen")</button>
                </form>
                <form method="post" asp-page-handler="Code">
                    <button class="btn btn-link"><span class="ico ico-key" aria-hidden="true"></span>@T("Download klappt nicht? Code zum Abtippen anzeigen")</button>
                </form>
            </div>
            <div class="form-text">@F("Version {0}. Jeder Download enthält einen eigenen Kopplungscode, gültig 24 Stunden und nur für ein Gerät.", Model.ClientVersion ?? T("unbekannt"))</div>
        }
        else
        {
            <div class="alert alert-warning mb-0">@T("Das Installationsprogramm ist auf dem Server noch nicht vorhanden. Bitte den Server-Betreiber fragen.")</div>
        }
        @if (Model.ManualCode is not null)
        {
            <div class="alert alert-info mt-3 mb-0" role="status">
                <div class="mb-1">@T("Im Installationsprogramm eintippen:")</div>
                <div>@T("Serveradresse:") <code>@Model.ServerUrl</code></div>
                <div>@T("Kopplungscode (24 h gültig):") <span class="code-box">@Model.ManualCode</span></div>
            </div>
        }
    </div>
</details>

@foreach (var d in Model.Devices)
{
    var online = d.IsOnline(Model.Now);
    <div class="card device-card mb-3 @(d.Revoked ? "opacity-75" : "")">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="device-title">
                <span class="device-ico @(online && !d.Revoked ? "is-online" : "")" aria-hidden="true"><span class="ico ico-laptop" aria-hidden="true"></span></span>
                <div class="min-w-0">
                    <h2 class="fs-5 mb-1 text-truncate">@d.Name</h2>
                    @if (d.Revoked) { <span class="pill pill-muted">@T("entfernt")</span> }
                    else if (online) { <span class="pill pill-ok pill-live">@T("online")</span> }
                    else { <span class="pill pill-muted">@T("offline")</span> }
                </div>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="small text-muted fw-normal device-meta">@F("Zuletzt gemeldet: {0}", Format.Ago(d.LastSeenUtc, Model.Now)) · PaCo @d.ClientVersion · @d.OsVersion</span>
                @if (!d.Revoked)
                {
                    <a asp-page="./Log" asp-route-id="@d.Id" class="btn btn-sm btn-outline-secondary"><span class="ico ico-list" aria-hidden="true"></span>@T("Protokoll")</a>
                    <a asp-page="./Location" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">
                        <span class="ico ico-pin" aria-hidden="true"></span>@(d.LocationMode switch { LocationMode.Continuous => T("Standort (aufgezeichnet)"), LocationMode.OnRequest => T("Standort (auf Anforderung)"), _ => T("Standort (aus)") })
                    </a>
                }
            </div>
        </div>
        <div class="card-body">
            @if (!d.Revoked && Model.UpdateAvailable(d))
            {
                <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
                    @if (d.UpdateRequested)
                    {
                        <span><span class="ico ico-hourglass me-1" aria-hidden="true"></span>@F("Update auf Version {0} wird beim nächsten Kontakt installiert …", Model.ClientVersion)</span>
                    }
                    else
                    {
                        <span>@F("Neue PaCo-Version {0} verfügbar (installiert: {1}).", Model.ClientVersion, d.ClientVersion ?? "?")</span>
                        <form method="post" asp-page-handler="Update">
                            <input type="hidden" name="deviceId" value="@d.Id" />
                            <button class="btn btn-sm btn-primary"><span class="ico ico-download" aria-hidden="true"></span>@T("Update installieren")</button>
                        </form>
                    }
                </div>
            }
            @if (!d.Revoked && d.SecurityCheckedUtc is not null)
            {
                var sec = d.GetSecurity();
                var worst = sec.Count == 0 ? SecuritySeverity.Ok : sec.Max(x => x.Severity);
                <details class="mb-3 sec-check" open="@(worst >= SecuritySeverity.Warning)">
                    <summary class="fw-semibold">
                        <span class="ico ico-shield-check text-muted" aria-hidden="true"></span>@T("Sicherheits-Check:")
                        @switch (worst)
                        {
                            case SecuritySeverity.Critical: <span class="status-blocked d-inline-flex align-items-center gap-1"><span class="ico ico-x-circle" aria-hidden="true"></span>@T("Handlungsbedarf")</span> break;
                            case SecuritySeverity.Warning: <span class="status-warn d-inline-flex align-items-center gap-1"><span class="ico ico-alert" aria-hidden="true"></span>@T("Hinweise")</span> break;
                            default: <span class="status-ok d-inline-flex align-items-center gap-1"><span class="ico ico-check-circle" aria-hidden="true"></span>@T("alles in Ordnung")</span> break;
                        }
                        <span class="small text-muted fw-normal">@F("(geprüft {0})", Format.Ago(d.SecurityCheckedUtc, Model.Now))</span>
                    </summary>
                    <ul class="list-unstyled small mt-2 mb-0 sec-list">
                        @foreach (var x in sec.OrderByDescending(x => x.Severity))
                        {
                            var (icon, cls) = x.Severity switch
                            {
                                SecuritySeverity.Critical => ("x-circle", "status-blocked"),
                                SecuritySeverity.Warning => ("alert", "status-warn"),
                                SecuritySeverity.Info => ("info", "text-muted"),
                                _ => ("check-circle", "status-ok"),
                            };
                            <li class="mb-1"><span class="ico ico-@icon @cls" aria-hidden="true"></span><span>@Ui.Render(x.Template, x.Args, x.Text)</span></li>
                        }
                    </ul>
                    @if (sec.Any(x => x.Fixable && x.Severity >= SecuritySeverity.Info))
                    {
                        <div class="small text-muted mt-1">@T("Automatische Korrektur: PaCo-Setup auf dem PC im Admin-Konto erneut starten → „Aktualisieren“, oder Einrichtung neu durchlaufen.")</div>
                    }
                </details>
            }
            @if (!d.Revoked)
            {
                <h3 class="section-title mb-1"><span class="ico ico-users" aria-hidden="true"></span>@T("Windows-Konten auf diesem PC")</h3>
                <p class="small text-muted mb-2">@T("Wähle bei jedem Konto, welches Kind es benutzt. Konten von Erwachsenen bleiben „nicht überwacht“.")</p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>@T("Konto")</th><th>@T("Gehört zu")</th></tr></thead>
                        <tbody>
                            @foreach (var a in d.Accounts.OrderBy(a => a.UserName))
                            {
                                <tr>
                                    <td>
                                        <div>@a.UserName @if (!string.IsNullOrWhiteSpace(a.FullName) && a.FullName != a.UserName) { <span class="text-muted small">(@a.FullName)</span> }</div>
                                        @if (a.IsAdmin)
                                        {
                                            <div class="small @(a.ChildId is null ? "text-muted" : "text-danger fw-semibold")">
                                                @if (a.ChildId is not null) { <span class="ico ico-alert ico-sm" aria-hidden="true"></span> }
                                                @(a.ChildId is null ? T("Administrator") : T("Administrator – Kinderkonten müssen Standardkonten sein!"))
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="Assign" class="d-flex flex-wrap gap-2">
                                            <input type="hidden" name="accountId" value="@a.Id" />
                                            <select name="childId" class="form-select form-select-sm" aria-label="@F("Konto {0} gehört zu", a.UserName)">
                                                <option value="">@T("— nicht überwacht (Erwachsene) —")</option>
                                                @foreach (var c in Model.Children)
                                                {
                                                    <option value="@c.Id" selected="@(a.ChildId == c.Id)">@c.Name</option>
                                                }
                                            </select>
                                            <button class="btn btn-sm btn-outline-primary">@T("Speichern")</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <form method="post" asp-page-handler="Silent" class="mb-3">
                    <input type="hidden" name="deviceId" value="@d.Id" />
                    <label class="form-label small fw-semibold mb-1" for="silent-@d.Id"><span class="ico ico-bell ico-sm" aria-hidden="true"></span>@T("Warnung bei fehlendem Kontakt (Tage, 0 = aus)")</label>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <input id="silent-@d.Id" name="days" type="number" min="0" max="@SilentDevices.MaxDays" step="1" inputmode="numeric" value="@d.SilentAlertDays" class="form-control form-control-sm w-auto" required aria-describedby="silent-help-@d.Id" />
                        <button class="btn btn-sm btn-outline-primary">@T("Speichern")</button>
                    </div>
                    <div class="form-text" id="silent-help-@d.Id">@T("Push-Nachricht an die Eltern, wenn dieser PC so lange keinen Kontakt zum Server hatte – z. B. weil PaCo abgeschaltet wurde. Ein ausgeschalteter oder verreister PC meldet sich natürlich auch nicht.")</div>
                </form>
                @if (Model.LanWatch)
                {
                    <form method="post" asp-page-handler="Lan" class="mb-3">
                        <input type="hidden" name="deviceId" value="@d.Id" />
                        <input type="hidden" name="enabled" value="@(d.LanAlert ? "false" : "true")" />
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <span class="small fw-semibold"><span class="ico ico-wifi ico-sm" aria-hidden="true"></span>@T("Warnen, wenn der PC im Heimnetz an ist, PaCo sich aber nicht meldet")</span>
                            @if (d.LanAlert) { <span class="pill pill-ok">@T("aktiv")</span> } else { <span class="pill pill-muted">@T("Aus")</span> }
                            <button class="btn btn-sm btn-outline-primary">@(d.LanAlert ? T("Ausschalten") : T("Einschalten"))</button>
                        </div>
                        <div class="form-text">
                            @F("Der Server sieht die Geräte in seinem eigenen Netzwerk. Ist dieser PC dort {0} Minuten lang eingeschaltet, ohne dass PaCo sich meldet, bekommen die Eltern eine Push-Nachricht.", Model.LanMinutes)
                            @if (d.LanSeenUtc is not null) { <span>@F("Im Heimnetz gesehen: {0}", Format.Ago(d.LanSeenUtc, Model.Now))</span> }
                        </div>
                    </form>
                }
                <div class="d-flex flex-wrap justify-content-between gap-2">
                    <form method="post" asp-page-handler="Rename" class="d-flex gap-2">
                        <input type="hidden" name="deviceId" value="@d.Id" />
                        <input name="name" value="@d.Name" class="form-control form-control-sm" aria-label="@F("Neuer Name für {0}", d.Name)" maxlength="100" required autocomplete="off" />
                        <button class="btn btn-sm btn-outline-secondary text-nowrap"><span class="ico ico-edit" aria-hidden="true"></span>@T("Umbenennen")</button>
                    </form>
                    <form method="post" asp-page-handler="Revoke">
                        <input type="hidden" name="deviceId" value="@d.Id" />
                        <button class="btn btn-sm btn-outline-danger" data-confirm="@F("{0} wirklich entfernen? Alle Sperren auf diesem PC werden aufgehoben.", d.Name)"><span class="ico ico-trash" aria-hidden="true"></span>@T("Gerät entfernen")</button>
                    </form>
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="deviceId" value="@d.Id" />
                    <button class="btn btn-sm btn-outline-secondary" data-confirm="@T("Gerät und seine Statistik endgültig löschen?")"><span class="ico ico-trash" aria-hidden="true"></span>@T("Endgültig löschen")</button>
                </form>
            }
        </div>
    </div>
}
</div>

@page
@model PaCo.Server.Pages.Admin.IndexModel
@{ ViewData["Title"] = T("Verwaltung"); }

<div class="page-head">
    <div class="page-head-main">
        <span class="page-icon" aria-hidden="true"><span class="ico ico-shield" aria-hidden="true"></span></span>
        <div class="min-w-0">
            <h1 class="h3 page-title mb-1">@T("Verwaltung")</h1>
            <p class="text-muted mb-0">@T("Eltern-Konten und Familien verwalten. Kinderdaten sind hier bewusst nicht sichtbar.")</p>
        </div>
    </div>
</div>

@if (Model.InviteLink is not null)
{
    <div class="alert alert-info" role="status">
        <div class="fw-semibold mb-1">@F("Zugangslink für {0}", Model.InviteFor)</div>
        <div class="small mb-2">@T("7 Tage gültig, nur einmal benutzbar. Schick ihn z. B. per WhatsApp oder Signal. Damit legt die Person ihr Passwort fest und richtet die Authenticator-App ein.")</div>
        <div class="input-group">
            <input id="invite-link" class="form-control font-monospace small" value="@Model.InviteLink" readonly aria-label="@T("Zugangslink")" />
            <button class="btn btn-primary" data-copy="#invite-link" type="button"><span class="ico ico-copy" aria-hidden="true"></span>@T("Kopieren")</button>
            <button class="btn btn-outline-primary" data-share="#invite-link" data-share-title="@T("Zugang zu PaCo")" type="button" hidden>@T("Teilen")</button>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-user-plus" aria-hidden="true"></span></span>@T("Eltern einladen")</div>
    <div class="card-body">
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <form method="post" asp-page-handler="Invite" class="row g-3">
            <div class="col-md-6">
                <label asp-for="InviteName" class="form-label">@T("Name")</label>
                <input asp-for="InviteName" class="form-control" placeholder="@T("z. B. Anna")" autocomplete="off" />
            </div>
            <div class="col-md-6">
                <label asp-for="InviteEmail" class="form-label">@T("E-Mail (Benutzername)")</label>
                <input asp-for="InviteEmail" class="form-control" autocomplete="off" autocapitalize="off" spellcheck="false" />
            </div>
            <div class="col-md-6">
                <label asp-for="InviteFamilyId" class="form-label">@T("Familie")</label>
                <select asp-for="InviteFamilyId" class="form-select">
                    <option value="">➕ @T("Neue Familie anlegen")</option>
                    @foreach (var f in Model.Families)
                    {
                        <option value="@f.Family.Id">@F("{0} (weiteres Elternteil)", f.Family.Name)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="NewFamilyName" class="form-label">@T("Name der neuen Familie")</label>
                <input asp-for="NewFamilyName" class="form-control" placeholder="@T("z. B. Müller")" autocomplete="off" />
                <div class="form-text">@T("Nur nötig bei „Neue Familie“. Jede Familie sieht ausschließlich ihre eigenen Kinder und Geräte.")</div>
            </div>
            <div class="col-12">
                <button class="btn btn-primary"><span class="ico ico-link" aria-hidden="true"></span>@T("Einladungslink erstellen")</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-users" aria-hidden="true"></span></span>@T("Eltern-Konten")</div>
    <div class="list-group list-group-flush">
        @foreach (var u in Model.Parents)
        {
            var blocked = u.LockoutEnd is { } le && le > Model.Now;
            <div class="list-group-item py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="min-w-0">
                        <div class="fw-semibold">@u.DisplayName <span class="text-muted fw-normal small">· @u.Family?.Name</span></div>
                        <div class="small text-muted text-truncate">@u.Email · @F("zuletzt {0}", Format.Ago(u.LastLoginUtc, Model.Now))</div>
                    </div>
                    <div>
                        @if (blocked && u.LockoutEnd == DateTimeOffset.MaxValue) { <span class="pill pill-bad">@T("gesperrt")</span> }
                        else if (blocked) { <span class="pill pill-bad">@T("Fehlversuche – kurz gesperrt")</span> }
                        else if (u.InvitePending) { <span class="pill pill-muted">@T("Einladung offen")</span> }
                        else if (!u.TwoFactorEnabled) { <span class="pill pill-bad">@T("2FA fehlt")</span> }
                        else { <span class="pill pill-ok">@T("aktiv")</span> }
                    </div>
                </div>
                <details class="mt-2">
                    <summary class="small text-muted">@T("Verwalten")</summary>
                    <div class="d-flex flex-wrap gap-2 align-items-end mt-2">
                        @if (!u.InvitePending)
                        {
                            <form method="post" asp-page-handler="ResetPassword">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <button class="btn btn-sm btn-outline-primary" data-confirm="@T("Nur das Passwort zurücksetzen? Die Person bekommt einen Link und wählt selbst ein neues Passwort – die Authenticator-App bleibt.")">@T("Passwort zurücksetzen")</button>
                            </form>
                            <form method="post" asp-page-handler="ResetTwoFactor">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <button class="btn btn-sm btn-outline-primary" data-confirm="@T("Nur die Authenticator-App zurücksetzen (z. B. Handy verloren)? Das Passwort bleibt; bei der nächsten Anmeldung wird die App neu eingerichtet.")">@T("2FA zurücksetzen")</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="NewLink">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <button class="btn btn-sm btn-outline-primary" data-confirm="@(u.InvitePending ? T("Neuen Einladungslink erstellen? Der alte wird ungültig.") : T("Passwort und 2FA zurücksetzen und neuen Zugangslink erstellen? Die Person muss sich danach neu einrichten."))">
                                @(u.InvitePending ? T("Neuer Einladungslink") : T("Beides zurücksetzen"))
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Block">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <input type="hidden" name="blocked" value="@((!blocked).ToString().ToLowerInvariant())" />
                            <button class="btn btn-sm btn-outline-secondary" data-confirm="@(blocked ? F("{0} entsperren?", u.Email) : F("{0} sperren? Die Person kann sich dann nicht mehr anmelden.", u.Email))">@(blocked ? T("Entsperren") : T("Sperren"))</button>
                        </form>
                        <form method="post" asp-page-handler="MoveUser" class="d-flex gap-1">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <select name="familyId" class="form-select form-select-sm" aria-label="@T("Familie wechseln")">
                                @foreach (var f in Model.Families)
                                {
                                    <option value="@f.Family.Id" selected="@(u.FamilyId == f.Family.Id)">@f.Family.Name</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-secondary text-nowrap" data-confirm="@F("{0} in die gewählte Familie verschieben? Die Person sieht danach nur noch deren Kinder.", u.Email)">@T("Familie wechseln")</button>
                        </form>
                        <form method="post" asp-page-handler="DeleteUser" class="ms-auto">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <button class="btn btn-sm btn-outline-danger" data-confirm="@F("Konto {0} wirklich löschen?", u.Email)"><span class="ico ico-trash" aria-hidden="true"></span>@T("Konto löschen")</button>
                        </form>
                    </div>
                    <div class="small text-muted mt-1">@F("„{0}“ = Passwort vergessen oder Handy verloren: Die Person bekommt einen neuen Link und richtet Passwort und 2FA neu ein.", T("Zugang zurücksetzen"))</div>
                </details>
            </div>
        }
        @if (Model.Parents.Count == 0)
        {
            <div class="list-group-item text-muted">@T("Noch keine Eltern eingeladen.")</div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-heart" aria-hidden="true"></span></span>@T("Familien")</div>
    <div class="list-group list-group-flush">
        @foreach (var f in Model.Families)
        {
            <div class="list-group-item py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="fw-semibold">@f.Family.Name</div>
                    <div class="small text-muted">@(f.Parents == 1 ? T("1 Elternteil") : F("{0} Eltern", f.Parents)) · @(f.Children == 1 ? T("1 Kind") : F("{0} Kinder", f.Children)) · @(f.Devices == 1 ? T("1 Gerät") : F("{0} Geräte", f.Devices))</div>
                </div>
                <details class="mt-2">
                    <summary class="small text-muted">@T("Verwalten")</summary>
                    <div class="row g-2 mt-1">
                        <div class="col-md-6">
                            <form method="post" asp-page-handler="RenameFamily" class="d-flex gap-1">
                                <input type="hidden" name="familyId" value="@f.Family.Id" />
                                <input name="name" value="@f.Family.Name" class="form-control form-control-sm" aria-label="@T("Familienname")" />
                                <button class="btn btn-sm btn-outline-secondary">@T("Umbenennen")</button>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <form method="post" asp-page-handler="DeleteFamily" class="d-flex gap-1">
                                <input type="hidden" name="familyId" value="@f.Family.Id" />
                                <input name="confirm" class="form-control form-control-sm" placeholder="@T("Zum Löschen Namen eintippen")" aria-label="@T("Familienname zur Bestätigung")" />
                                <button class="btn btn-sm btn-outline-danger" data-confirm="@F("Familie {0} mit ALLEN Daten löschen? Das kann nicht rückgängig gemacht werden.", f.Family.Name)"><span class="ico ico-trash" aria-hidden="true"></span>@T("Löschen")</button>
                            </form>
                        </div>
                    </div>
                </details>
            </div>
        }
    </div>
</div>
<div class="card mb-4">
    <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-laptop" aria-hidden="true"></span></span>@T("PaCo-Client (Windows)")</div>
    <div class="card-body">
        <p class="mb-2">
            @T("Angebotene Version:") <strong>@(Model.ClientBuild?.Version ?? T("keine"))</strong>
            <span class="text-muted">(@Model.ClientBuild?.Source)</span><br />
            @Html.Raw(F("Geräte: {0}, davon veraltet: {1}", Model.DevicesTotal, "<strong>" + Model.DevicesOutdated + "</strong>"))
        </p>
        <div class="d-flex flex-wrap gap-2">
            <form method="post" asp-page-handler="CheckUpdates">
                <button class="btn btn-outline-primary"><span class="ico ico-refresh" aria-hidden="true"></span>@T("Auf GitHub nach Updates suchen")</button>
            </form>
            @if (Model.DevicesOutdated > 0)
            {
                <form method="post" asp-page-handler="UpdateAll">
                    <button class="btn btn-primary" data-confirm="@F("Alle veralteten Geräte (alle Familien) auf Version {0} aktualisieren?", Model.ClientBuild?.Version)"><span class="ico ico-download" aria-hidden="true"></span>@T("Alle Geräte aktualisieren")</button>
                </form>
            }
        </div>
        <div class="form-text">@T("Updates werden von GitHub geladen, per Prüfsumme kontrolliert und vom Server signiert. Die PCs installieren nur signierte Updates dieses Servers.")</div>
        <a asp-page="./Health" class="btn btn-sm btn-outline-secondary mt-2"><span class="ico ico-activity" aria-hidden="true"></span>@T("Geräte-Zustand & Fehler")</a>
    </div>
</div>

<div class="card">
    <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-shield" aria-hidden="true"></span></span>@T("Super-Admins")</div>
    <ul class="list-group list-group-flush">
        @foreach (var a in Model.Admins)
        {
            <li class="list-group-item">@a.Email <span class="text-muted small">· @F("letzter Login {0}", Format.Ago(a.LastLoginUtc, Model.Now))</span></li>
        }
    </ul>
    <div class="card-body small text-muted">@T("Super-Admins werden nur auf dem Server angelegt:") <code>docker exec -it paco dotnet PaCo.Server.dll admin-create @T("E-MAIL")</code></div>
</div>

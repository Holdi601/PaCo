@page
@model PaCo.Server.Pages.Admin.IndexModel
@{ ViewData["Title"] = "Verwaltung"; }

<h1 class="h3 mb-3">Verwaltung</h1>

@if (Model.InviteLink is not null)
{
    <div class="alert alert-info">
        <div class="fw-semibold mb-1">Zugangslink für @Model.InviteFor</div>
        <div class="small mb-2">7 Tage gültig, nur einmal benutzbar. Schick ihn z. B. per WhatsApp oder Signal. Damit legt die Person ihr Passwort fest und richtet die Authenticator-App ein.</div>
        <div class="input-group">
            <input id="invite-link" class="form-control font-monospace small" value="@Model.InviteLink" readonly />
            <button class="btn btn-primary" data-copy="#invite-link" type="button">Kopieren</button>
        </div>
    </div>
}

<div class="card mb-4">
    <div class="card-header">Eltern einladen</div>
    <div class="card-body">
        <div asp-validation-summary="All" class="alert alert-danger"></div>
        <form method="post" asp-page-handler="Invite" class="row g-3">
            <div class="col-md-6">
                <label asp-for="InviteName" class="form-label">Name</label>
                <input asp-for="InviteName" class="form-control" placeholder="z. B. Anna" />
            </div>
            <div class="col-md-6">
                <label asp-for="InviteEmail" class="form-label">E-Mail (Benutzername)</label>
                <input asp-for="InviteEmail" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="InviteFamilyId" class="form-label">Familie</label>
                <select asp-for="InviteFamilyId" class="form-select">
                    <option value="">➕ Neue Familie anlegen</option>
                    @foreach (var f in Model.Families)
                    {
                        <option value="@f.Family.Id">@f.Family.Name (weiteres Elternteil)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="NewFamilyName" class="form-label">Name der neuen Familie</label>
                <input asp-for="NewFamilyName" class="form-control" placeholder="z. B. Müller" />
                <div class="form-text">Nur nötig bei „Neue Familie“. Jede Familie sieht ausschließlich ihre eigenen Kinder und Geräte.</div>
            </div>
            <div class="col-12">
                <button class="btn btn-primary">Einladungslink erstellen</button>
            </div>
        </form>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Eltern-Konten</div>
    <div class="list-group list-group-flush">
        @foreach (var u in Model.Parents)
        {
            var blocked = u.LockoutEnd is { } le && le > Model.Now;
            <div class="list-group-item py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="min-w-0">
                        <div class="fw-semibold">@u.DisplayName <span class="text-muted fw-normal small">· @u.Family?.Name</span></div>
                        <div class="small text-muted text-truncate">@u.Email · zuletzt @Format.Ago(u.LastLoginUtc, Model.Now)</div>
                    </div>
                    <div>
                        @if (blocked && u.LockoutEnd == DateTimeOffset.MaxValue) { <span class="pill pill-bad">gesperrt</span> }
                        else if (blocked) { <span class="pill pill-bad">Fehlversuche – kurz gesperrt</span> }
                        else if (u.InvitePending) { <span class="pill pill-muted">Einladung offen</span> }
                        else if (!u.TwoFactorEnabled) { <span class="pill pill-bad">2FA fehlt</span> }
                        else { <span class="pill pill-ok">aktiv</span> }
                    </div>
                </div>
                <details class="mt-2">
                    <summary class="small text-muted">Verwalten</summary>
                    <div class="d-flex flex-wrap gap-2 align-items-end mt-2">
                        <form method="post" asp-page-handler="NewLink">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <button class="btn btn-sm btn-outline-primary" data-confirm="@(u.InvitePending ? "Neuen Einladungslink erstellen? Der alte wird ungültig." : "Passwort und 2FA zurücksetzen und neuen Zugangslink erstellen? Die Person muss sich danach neu einrichten.")">
                                @(u.InvitePending ? "Neuer Einladungslink" : "Zugang zurücksetzen")
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Block">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <input type="hidden" name="blocked" value="@((!blocked).ToString().ToLowerInvariant())" />
                            <button class="btn btn-sm btn-outline-secondary">@(blocked ? "Entsperren" : "Sperren")</button>
                        </form>
                        <form method="post" asp-page-handler="MoveUser" class="d-flex gap-1">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <select name="familyId" class="form-select form-select-sm" aria-label="Familie wechseln">
                                @foreach (var f in Model.Families)
                                {
                                    <option value="@f.Family.Id" selected="@(u.FamilyId == f.Family.Id)">@f.Family.Name</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-secondary text-nowrap">Familie wechseln</button>
                        </form>
                        <form method="post" asp-page-handler="DeleteUser" class="ms-auto">
                            <input type="hidden" name="userId" value="@u.Id" />
                            <button class="btn btn-sm btn-outline-danger" data-confirm="Konto @u.Email wirklich löschen?">Konto löschen</button>
                        </form>
                    </div>
                    <div class="small text-muted mt-1">„Zugang zurücksetzen“ = Passwort vergessen oder Handy verloren: Die Person bekommt einen neuen Link und richtet Passwort und 2FA neu ein.</div>
                </details>
            </div>
        }
        @if (Model.Parents.Count == 0)
        {
            <div class="list-group-item text-muted">Noch keine Eltern eingeladen.</div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Familien</div>
    <div class="list-group list-group-flush">
        @foreach (var f in Model.Families)
        {
            <div class="list-group-item py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="fw-semibold">@f.Family.Name</div>
                    <div class="small text-muted">@f.Parents Eltern · @f.Children Kinder · @f.Devices Geräte</div>
                </div>
                <details class="mt-2">
                    <summary class="small text-muted">Verwalten</summary>
                    <div class="row g-2 mt-1">
                        <div class="col-md-6">
                            <form method="post" asp-page-handler="RenameFamily" class="d-flex gap-1">
                                <input type="hidden" name="familyId" value="@f.Family.Id" />
                                <input name="name" value="@f.Family.Name" class="form-control form-control-sm" aria-label="Familienname" />
                                <button class="btn btn-sm btn-outline-secondary">Umbenennen</button>
                            </form>
                        </div>
                        <div class="col-md-6">
                            <form method="post" asp-page-handler="DeleteFamily" class="d-flex gap-1">
                                <input type="hidden" name="familyId" value="@f.Family.Id" />
                                <input name="confirm" class="form-control form-control-sm" placeholder="Zum Löschen Namen eintippen" aria-label="Familienname zur Bestätigung" />
                                <button class="btn btn-sm btn-outline-danger" data-confirm="Familie @f.Family.Name mit ALLEN Daten löschen? Das kann nicht rückgängig gemacht werden.">Löschen</button>
                            </form>
                        </div>
                    </div>
                </details>
            </div>
        }
    </div>
</div>
<div class="card mb-4">
    <div class="card-header">PaCo-Client (Windows)</div>
    <div class="card-body">
        <p class="mb-2">
            Angebotene Version: <strong>@(Model.ClientBuild?.Version ?? "keine")</strong>
            <span class="text-muted">(@Model.ClientBuild?.Source)</span><br />
            Geräte: @Model.DevicesTotal, davon veraltet: <strong>@Model.DevicesOutdated</strong>
        </p>
        <div class="d-flex flex-wrap gap-2">
            <form method="post" asp-page-handler="CheckUpdates">
                <button class="btn btn-outline-primary">Auf GitHub nach Updates suchen</button>
            </form>
            @if (Model.DevicesOutdated > 0)
            {
                <form method="post" asp-page-handler="UpdateAll">
                    <button class="btn btn-primary" data-confirm="Alle veralteten Geräte (alle Familien) auf Version @Model.ClientBuild?.Version aktualisieren?">Alle Geräte aktualisieren</button>
                </form>
            }
        </div>
        <div class="form-text">Updates werden von GitHub geladen, per Prüfsumme kontrolliert und vom Server signiert. Die PCs installieren nur signierte Updates dieses Servers.</div>
    </div>
</div>

<div class="card">
    <div class="card-header">Super-Admins</div>
    <ul class="list-group list-group-flush">
        @foreach (var a in Model.Admins)
        {
            <li class="list-group-item">@a.Email <span class="text-muted small">· letzter Login @Format.Ago(a.LastLoginUtc, Model.Now)</span></li>
        }
    </ul>
    <div class="card-body small text-muted">Super-Admins werden nur auf dem Server angelegt: <code>docker exec -it paco dotnet PaCo.Server.dll admin-create E-MAIL</code></div>
</div>

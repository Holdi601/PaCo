@page "{id:guid}"
@model PaCo.Server.Pages.Children.EditModel
@{ ViewData["Title"] = $"Regeln für {Model.Name}"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Regeln für @Model.Name</h1>
    <a asp-page="/Dashboard" class="btn btn-outline-secondary btn-sm">Zurück</a>
</div>

<div asp-validation-summary="All" class="alert alert-danger"></div>

<form method="post" asp-route-id="@Model.Id">
    <div class="card mb-3">
        <div class="card-header">Allgemein</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" />
                </div>
                <div class="col-md-6">
                    <div class="form-label">Wenn die Zeit abgelaufen ist</div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="ExpiryAction" value="@ExpiryAction.LockScreen" id="ea-lock" />
                        <label class="form-check-label" for="ea-lock"><strong>Sperrbildschirm</strong> – Ton aus, schwarzer Bildschirm. Weiter nur mit Freischaltcode oder Zeit von der Website.</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="ExpiryAction" value="@ExpiryAction.Logoff" id="ea-logoff" />
                        <label class="form-check-label" for="ea-logoff"><strong>Abmelden</strong> – Ton aus, Kind wird sofort abgemeldet.</label>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="Paused" class="form-check-input" role="switch" />
                        <label asp-for="Paused" class="form-check-label">Überwachung pausieren (z. B. Ferien) – nichts wird gesperrt, Nutzung wird weiter erfasst</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Wochenplan</div>
        <div class="card-body">
            <p class="small text-muted">Pro Tag: wie viele Minuten insgesamt, und in welchem Zeitraum der PC benutzt werden darf. Zusatzzeit von der Website oder per Freischaltcode gilt auch außerhalb des Zeitraums.</p>
            <div class="table-responsive">
                <table class="table align-middle table-days">
                    <thead>
                        <tr><th>Tag</th><th>Minuten pro Tag</th><th>Erlaubt von – bis</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var dow in Format.WeekOrder)
                        {
                            var i = (int)dow;
                            <tr data-day-row="@i">
                                <td class="fw-semibold">@Format.WeekdayNames[i]</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <input asp-for="Days[i].LimitMinutes" type="number" min="0" max="1440" step="15" class="form-control form-control-sm" data-field="limit" />
                                        <div class="form-check text-nowrap mb-0">
                                            <input asp-for="Days[i].Unlimited" class="form-check-input" data-field="unlimited" />
                                            <label asp-for="Days[i].Unlimited" class="form-check-label small">unbegrenzt</label>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <input asp-for="Days[i].From" type="time" class="form-control form-control-sm w-auto" data-field="from" />
                                        <span>–</span>
                                        <input asp-for="Days[i].To" type="time" class="form-control form-control-sm w-auto" data-field="to" />
                                        <div class="form-check text-nowrap mb-0">
                                            <input asp-for="Days[i].AllDay" class="form-check-input" data-field="allday" />
                                            <label asp-for="Days[i].AllDay" class="form-check-label small">ganztags</label>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-sm btn-outline-secondary" data-copy-day="1" data-targets="2,3,4,5">Montag auf Di–Fr übertragen</button>
                <button class="btn btn-sm btn-outline-secondary" data-copy-day="6" data-targets="0">Samstag auf Sonntag übertragen</button>
                <button class="btn btn-sm btn-outline-secondary" data-copy-day="1" data-targets="0,2,3,4,5,6">Montag auf alle Tage übertragen</button>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Internet</div>
        <div class="card-body">
            <p class="small text-muted">Gilt für Microsoft Edge, Google Chrome und Firefox im Windows-Konto des Kindes.</p>
            <div class="form-check form-switch">
                <input asp-for="ForceSafeSearch" class="form-check-input" role="switch" />
                <label asp-for="ForceSafeSearch" class="form-check-label">SafeSearch bei Google und Bing erzwingen (filtert Erwachsenen-Inhalte in Suchergebnissen)</label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="YouTubeRestricted" class="form-check-input" role="switch" />
                <label asp-for="YouTubeRestricted" class="form-check-label">YouTube im eingeschränkten Modus</label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="BlockPrivateBrowsing" class="form-check-input" role="switch" />
                <label asp-for="BlockPrivateBrowsing" class="form-check-label">Privates Surfen (InPrivate/Inkognito) und Gastmodus sperren</label>
            </div>
            <div class="form-check form-switch mb-3">
                <input asp-for="BlockOtherBrowsers" class="form-check-input" role="switch" />
                <label asp-for="BlockOtherBrowsers" class="form-check-label">Andere Browser sperren (Opera, Brave, Tor, …) – sonst könnten die Regeln umgangen werden</label>
            </div>

            <label asp-for="BlockedSites" class="form-label">Gesperrte Webseiten (eine pro Zeile)</label>
            <textarea asp-for="BlockedSites" class="form-control font-monospace" rows="5" placeholder="tiktok.com"></textarea>
            <div class="mt-2 small">Schnell hinzufügen:</div>
            <div class="d-flex flex-wrap gap-3 mt-1">
                @foreach (var p in PaCo.Server.Pages.Children.EditModel.SitePresets.Keys)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="AddPresets" value="@p" id="preset-@p.GetHashCode()" />
                        <label class="form-check-label small" for="preset-@p.GetHashCode()">@p</label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Gesperrte Programme</div>
        <div class="card-body">
            <label asp-for="BlockedApps" class="form-label">Programmname (eine pro Zeile) – das Programm wird sofort geschlossen, wenn es gestartet wird</label>
            <textarea asp-for="BlockedApps" class="form-control font-monospace" rows="4" placeholder="discord"></textarea>
            <div class="form-text">Den Programmnamen findest du unter <a asp-page="./Stats" asp-route-id="@Model.Id">Statistik</a> (z. B. <code>robloxplayerbeta</code>, <code>steam</code>, <code>discord</code>).</div>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <button type="submit" class="btn btn-primary btn-lg">Speichern</button>
    </div>
</form>

<form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" class="mt-4 text-end">
    <button class="btn btn-sm btn-outline-danger" data-confirm="@Model.Name wirklich löschen? Statistik und Regeln gehen verloren.">Kind löschen</button>
</form>

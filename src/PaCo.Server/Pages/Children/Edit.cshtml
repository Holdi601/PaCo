@page "{id:guid}"
@model PaCo.Server.Pages.Children.EditModel
@{ ViewData["Title"] = F("Regeln für {0}", Model.Name); }

<div class="page-head">
    <div class="page-head-main">
        <span class="page-icon" aria-hidden="true"><span class="ico ico-sliders" aria-hidden="true"></span></span>
        <div class="min-w-0">
            <div class="stat-label">@T("Regeln")</div>
            <h1 class="h3 mb-0 page-title">@Model.Name</h1>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Stats" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm"><span class="ico ico-chart" aria-hidden="true"></span>@T("Statistik")</a>
        <a asp-page="/Dashboard" class="btn btn-outline-secondary btn-sm"><span class="ico ico-back" aria-hidden="true"></span>@T("Übersicht")</a>
    </div>
</div>

<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

<form method="post" asp-route-id="@Model.Id">
    <section class="card mb-3" aria-labelledby="sec-week">
        <div class="card-header" id="sec-week"><span class="head-ico" aria-hidden="true"><span class="ico ico-calendar" aria-hidden="true"></span></span>@T("Bildschirmzeit pro Tag")</div>
        <div class="card-body">
            <p class="small text-muted">@T("Pro Tag: wie viele Minuten insgesamt (60 = 1 Stunde, 120 = 2 Stunden) und in welchem Zeitraum der PC benutzt werden darf. Zusatzzeit von der Übersicht oder per Freischaltcode gilt auch außerhalb des Zeitraums.")</p>
            <div class="table-days">
                <div class="row g-2 d-none d-md-flex small text-muted fw-semibold pb-1" aria-hidden="true">
                    <div class="col-md-2">@T("Tag")</div>
                    <div class="col-md-4">@T("Minuten pro Tag")</div>
                    <div class="col-md-6">@T("Erlaubt von – bis")</div>
                </div>
                @foreach (var dow in Format.WeekOrder)
                {
                    var i = (int)dow;
                    var day = Format.DayName(dow);
                    <div class="day-row row g-2 align-items-center py-2" data-day-row="@i" role="group" aria-label="@day">
                        <div class="col-12 col-md-2 fw-semibold">@day</div>
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="d-flex align-items-center gap-2">
                                <label asp-for="Days[i].LimitMinutes" class="visually-hidden">@F("Minuten am {0}", day)</label>
                                <div class="input-group input-group-sm w-auto">
                                    <input asp-for="Days[i].LimitMinutes" type="number" min="0" max="1440" step="15" inputmode="numeric" class="form-control" data-field="limit" />
                                    <span class="input-group-text">@T("Min")</span>
                                </div>
                                <div class="form-check text-nowrap mb-0">
                                    <input asp-for="Days[i].Unlimited" class="form-check-input" data-field="unlimited" />
                                    <label asp-for="Days[i].Unlimited" class="form-check-label small">@T("unbegrenzt")</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-md-6">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <label asp-for="Days[i].From" class="visually-hidden">@F("{0} erlaubt ab", day)</label>
                                <input asp-for="Days[i].From" type="time" class="form-control form-control-sm w-auto" data-field="from" />
                                <span aria-hidden="true">–</span>
                                <label asp-for="Days[i].To" class="visually-hidden">@F("{0} erlaubt bis", day)</label>
                                <input asp-for="Days[i].To" type="time" class="form-control form-control-sm w-auto" data-field="to" />
                                <div class="form-check text-nowrap mb-0">
                                    <input asp-for="Days[i].AllDay" class="form-check-input" data-field="allday" />
                                    <label asp-for="Days[i].AllDay" class="form-check-label small">@T("ganztags")</label>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-day="1" data-targets="2,3,4,5"><span class="ico ico-copy" aria-hidden="true"></span>@F("{0} auf {1}–{2} übertragen", Format.DayName(DayOfWeek.Monday), Format.ShortDayName(DayOfWeek.Tuesday), Format.ShortDayName(DayOfWeek.Friday))</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-day="6" data-targets="0"><span class="ico ico-copy" aria-hidden="true"></span>@F("{0} auf {1} übertragen", Format.DayName(DayOfWeek.Saturday), Format.DayName(DayOfWeek.Sunday))</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-copy-day="1" data-targets="0,2,3,4,5,6"><span class="ico ico-copy" aria-hidden="true"></span>@F("{0} auf alle Tage übertragen", Format.DayName(DayOfWeek.Monday))</button>
            </div>

            <input type="hidden" name="TimeDevicesForm" value="true" />
            <fieldset class="mt-4">
                <legend class="form-label fw-semibold fs-6">@T("Gilt die Zeit für alle PCs zusammen?")</legend>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="TimePerDevice" id="tpd-shared" value="false" checked="@(!Model.TimePerDevice)" />
                    <label class="form-check-label" for="tpd-shared">@T("Ja, zusammen (empfohlen) – 1 Stunde am Laptop fehlt dann am anderen PC.")</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="TimePerDevice" id="tpd-each" value="true" checked="@Model.TimePerDevice" />
                    <label class="form-check-label" for="tpd-each">@T("Nein, jeder PC hat die volle Zeit für sich.")</label>
                </div>
            </fieldset>
            @if (Model.ChildDevices.Count > 0)
            {
                <fieldset class="mt-3">
                    <legend class="form-label fw-semibold fs-6">@T("Auf welchen PCs gilt das Zeitlimit?")</legend>
                    <p class="form-text mt-0">@T("Ausgeschaltet = keine Zeitbegrenzung und keine erlaubten Uhrzeiten auf diesem PC (z. B. Schul-Laptop). Programm- und Webseiten-Sperren und Alarme gelten dort trotzdem.")</p>
                    @foreach (var (devId, devName) in Model.ChildDevices)
                    {
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" name="TimeLimitDevices" value="@devId" id="tl-@devId" checked="@Model.TimeLimitDevices.Contains(devId)" />
                            <label class="form-check-label" for="tl-@devId">@devName</label>
                        </div>
                    }
                </fieldset>
            }
        </div>
    </section>

    <section class="card mb-3" aria-labelledby="sec-expiry">
        <div class="card-header" id="sec-expiry"><span class="head-ico" aria-hidden="true"><span class="ico ico-lock" aria-hidden="true"></span></span>@T("Wenn die Zeit abgelaufen ist")</div>
        <div class="card-body">
            <fieldset class="mb-3">
                <legend class="visually-hidden">@T("Was passiert, wenn die Zeit abgelaufen ist?")</legend>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="ExpiryAction" value="@ExpiryAction.LockScreen" id="ea-lock" />
                    <label class="form-check-label" for="ea-lock">@Html.Raw(T("<strong>Sperrbildschirm</strong> (empfohlen) – Ton aus, schwarzer Bildschirm. Weiter nur mit Freischaltcode oder Zeit von der Übersicht."))</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="ExpiryAction" value="@ExpiryAction.Logoff" id="ea-logoff" />
                    <label class="form-check-label" for="ea-logoff">@Html.Raw(T("<strong>Abmelden</strong> – Ton aus, das Kind wird sofort abgemeldet. Nicht gespeicherte Arbeit kann verloren gehen."))</label>
                </div>
            </fieldset>
            <div class="form-check form-switch">
                <input asp-for="Paused" class="form-check-input" role="switch" />
                <label asp-for="Paused" class="form-check-label">@T("Überwachung pausieren (z. B. in den Ferien) – nichts wird gesperrt, die Nutzung wird weiter erfasst")</label>
            </div>
        </div>
    </section>

    <section class="card mb-3" aria-labelledby="sec-web">
        <div class="card-header" id="sec-web"><span class="head-ico" aria-hidden="true"><span class="ico ico-globe" aria-hidden="true"></span></span>@T("Internet")</div>
        <div class="card-body">
            <p class="small text-muted">@T("Gilt für Microsoft Edge, Google Chrome und Firefox im Windows-Konto des Kindes.")</p>
            <div class="form-check form-switch">
                <input asp-for="ForceSafeSearch" class="form-check-input" role="switch" />
                <label asp-for="ForceSafeSearch" class="form-check-label">@T("SafeSearch bei Google und Bing erzwingen (filtert Erwachsenen-Inhalte in Suchergebnissen)")</label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="YouTubeRestricted" class="form-check-input" role="switch" />
                <label asp-for="YouTubeRestricted" class="form-check-label">@T("YouTube im eingeschränkten Modus")</label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="BlockPrivateBrowsing" class="form-check-input" role="switch" />
                <label asp-for="BlockPrivateBrowsing" class="form-check-label">@T("Privates Surfen (InPrivate/Inkognito) und Gastmodus sperren")</label>
            </div>
            <div class="form-check form-switch mb-2">
                <input asp-for="BlockDevTools" class="form-check-input" role="switch" />
                <label asp-for="BlockDevTools" class="form-check-label">@T("Entwicklertools im Browser (F12) sperren – damit lassen sich Sperren umgehen")</label>
            </div>
            <div class="form-check form-switch mb-3">
                <input asp-for="BlockOtherBrowsers" class="form-check-input" role="switch" />
                <label asp-for="BlockOtherBrowsers" class="form-check-label">@T("Andere Browser sperren (Opera, Brave, Tor, …) – sonst könnten die Regeln umgangen werden")</label>
            </div>

            <fieldset class="mb-3">
                <legend class="form-label fs-6 mb-1">@T("Ganze Gruppen sperren")</legend>
                <div class="small text-muted mb-1">@T("Ankreuzen und speichern – die Webseiten erscheinen danach in der Liste darunter.")</div>
                <div class="d-flex flex-wrap column-gap-3">
                    @{ var presetNo = 0; }
                    @foreach (var p in PaCo.Server.Pages.Children.EditModel.SitePresets.Keys)
                    {
                        presetNo++;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="AddPresets" value="@p" id="preset-@presetNo" />
                            <label class="form-check-label" for="preset-@presetNo">@T(p)</label>
                        </div>
                    }
                </div>
            </fieldset>

            <label asp-for="BlockedSites" class="form-label">@T("Gesperrte Webseiten")</label>
            <textarea asp-for="BlockedSites" class="form-control font-monospace" rows="5" placeholder="tiktok.com" autocapitalize="off" autocorrect="off" spellcheck="false" aria-describedby="sites-help"></textarea>
            <div id="sites-help" class="form-text">@Html.Raw(F("Eine Adresse pro Zeile, z. B. {0}.", "<code>tiktok.com</code>"))</div>
        </div>
    </section>

    <section class="card mb-3" aria-labelledby="sec-apps">
        <div class="card-header" id="sec-apps"><span class="head-ico" aria-hidden="true"><span class="ico ico-app" aria-hidden="true"></span></span>@T("Programme")</div>
        <div class="card-body">
            <fieldset class="mb-4">
                <legend class="form-label fw-semibold fs-6">@T("Windows-Werkzeuge")</legend>
                <p class="form-text mt-0">@T("Eingeschaltet = gesperrt. Gesperrte Werkzeuge kann dein Kind nicht öffnen – Windows zeigt dann einen Hinweis. Zum Erlauben einfach ausschalten und speichern.")</p>
                <input type="hidden" name="ToolsForm" value="true" />
                @{
                    var toolLabels = new (string Id, string Label)[]
                    {
                        ("powershell", T("PowerShell")),
                        ("cmd", T("Eingabeaufforderung (cmd)")),
                        ("regedit", T("Registry-Editor")),
                        ("scripts", T("Skript-Programme (VBScript, JScript, HTA) – werden oft von Schadsoftware genutzt")),
                        ("winget", T("Paketverwaltung winget (installiert Programme)")),
                    };
                }
                @foreach (var (toolId, toolLabel) in toolLabels)
                {
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" role="switch" name="BlockedTools" value="@toolId" id="tool-@toolId" checked="@Model.BlockedTools.Contains(toolId)" />
                        <label class="form-check-label" for="tool-@toolId">@toolLabel</label>
                    </div>
                }
                <div class="form-check form-switch mb-2">
                    <input asp-for="BlockStore" class="form-check-input" role="switch" />
                    <label asp-for="BlockStore" class="form-check-label">@T("Microsoft Store sperren – dein Kind kann keine Apps ohne dich installieren. Zum Installieren einer App kurz ausschalten. (empfohlen)")</label>
                </div>
            </fieldset>

            <fieldset class="mb-3">
                <legend class="form-label fw-semibold fs-6">@T("Programme deines Kindes")</legend>
                <input type="hidden" name="KnownAppsForm" value="true" />
                @if (Model.KnownApps.Count == 0)
                {
                    <p class="form-text mt-0">@T("Hier erscheinen die Programme, die dein Kind benutzt hat – jeweils mit einem Schalter zum Sperren oder Erlauben.")</p>
                }
                else
                {
                    <p class="form-text mt-0">@T("Programme der letzten 30 Tage. Eingeschaltet = gesperrt.")</p>
                    @foreach (var (process, appName) in Model.KnownApps)
                    {
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" role="switch" name="BlockedKnownApps" value="@process" id="app-@process.GetHashCode()" checked="@Model.BlockedKnownApps.Contains(process, StringComparer.OrdinalIgnoreCase)" />
                            <label class="form-check-label" for="app-@process.GetHashCode()">@appName <span class="text-muted small">(@process)</span></label>
                        </div>
                    }
                }
            </fieldset>

            <label asp-for="BlockedApps" class="form-label">@T("Weitere Programme sperren")</label>
            <textarea asp-for="BlockedApps" class="form-control font-monospace" rows="3" placeholder="discord" autocapitalize="off" autocorrect="off" spellcheck="false" aria-describedby="apps-help"></textarea>
            <div id="apps-help" class="form-text">@T("Ein Programmname pro Zeile – das Programm wird sofort wieder geschlossen, wenn es gestartet wird.") @T("Zum Erlauben die Zeile löschen.")</div>
        </div>
    </section>

    <section class="card mb-3" aria-labelledby="sec-groups">
        <div class="card-header" id="sec-groups"><span class="head-ico" aria-hidden="true"><span class="ico ico-clock" aria-hidden="true"></span></span>@T("Zeitlimits für Apps und Webseiten")</div>
        <div class="card-body">
            <p class="form-text mt-0">@T("Eigene Limits für einzelne Programme, Webseiten oder ganze Kategorien – kürzer als die Tageszeit. Gezählt wird nur, solange die App oder Webseite im Vordergrund ist. Ist die Zeit um, werden die Programme geschlossen und die Webseiten bis Mitternacht gesperrt.")</p>
            <p class="form-text">@T("Lernzeit: Solange eine Lern-App oder Lern-Webseite im Vordergrund ist, wird keine PC-Zeit verbraucht.") @T("Lern-Apps zählen erst als Lernzeit, wenn PaCo sie einmal auf dem PC gesehen hat – so wird ein umbenanntes Spiel nicht zur Lern-App.")</p>
            <input type="hidden" name="GroupsForm" value="true" />
            @for (var gi = 0; gi < Model.Groups.Count; gi++)
            {
                var gid = Model.Groups[gi].Id;
                <fieldset class="border rounded-3 p-3 mb-3">
                    <legend class="visually-hidden">@Model.Groups[gi].Name</legend>
                    <input type="hidden" name="Groups[@gi].Id" value="@gid" />
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-5">
                            <label class="form-label small" for="g-name-@gi">@T("Name")</label>
                            <input class="form-control" id="g-name-@gi" name="Groups[@gi].Name" value="@Model.Groups[gi].Name" maxlength="60" />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label small" for="g-kind-@gi">@T("Art")</label>
                            <select class="form-select" id="g-kind-@gi" name="Groups[@gi].Kind">
                                <option value="Limit" selected="@(Model.Groups[gi].Kind == TimeGroupKind.Limit)">@T("Eigenes Tageslimit")</option>
                                <option value="Free" selected="@(Model.Groups[gi].Kind == TimeGroupKind.Free)">@T("Lernzeit – zählt nicht als PC-Zeit")</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small" for="g-min-@gi">@T("Minuten pro Tag")</label>
                            <div class="input-group">
                                <input class="form-control" id="g-min-@gi" name="Groups[@gi].Minutes" type="number" min="1" max="1440" step="5" inputmode="numeric" value="@Model.Groups[gi].Minutes" />
                                <span class="input-group-text">@T("Min")</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small" for="g-apps-@gi">@T("Programme (ein Name pro Zeile)")</label>
                            <textarea class="form-control font-monospace" id="g-apps-@gi" name="Groups[@gi].Apps" rows="3" autocapitalize="off" autocorrect="off" spellcheck="false">@Model.Groups[gi].Apps</textarea>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label small" for="g-sites-@gi">@T("Webseiten (eine pro Zeile)")</label>
                            <textarea class="form-control font-monospace" id="g-sites-@gi" name="Groups[@gi].Sites" rows="3" autocapitalize="off" autocorrect="off" spellcheck="false">@Model.Groups[gi].Sites</textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="g-del-@gi" name="Groups[@gi].Remove" value="true" />
                                <label class="form-check-label small" for="g-del-@gi">@T("Diese Gruppe entfernen")</label>
                            </div>
                        </div>
                    </div>
                </fieldset>
            }
            @if (Model.KnownApps.Count > 0)
            {
                <p class="form-text">@T("Programmnamen deines Kindes:") @string.Join(", ", Model.KnownApps.Select(k => k.Process))</p>
            }
            <div class="d-flex flex-wrap gap-2 mt-2">
                <span class="small text-muted align-self-center">@T("Hinzufügen:")</span>
                @foreach (var p in PaCo.Server.Services.TimeGroupPresets.All)
                {
                    <button type="submit" class="btn btn-sm btn-outline-primary" name="AddGroupPreset" value="@p.Id"><span class="ico ico-plus" aria-hidden="true"></span>@T(p.Name)</button>
                }
            </div>
        </div>
    </section>

    <section class="card mb-3" aria-labelledby="sec-alerts">
        <div class="card-header" id="sec-alerts"><span class="head-ico" aria-hidden="true"><span class="ico ico-bell" aria-hidden="true"></span></span>@T("Alarme bei bedenklichen Stichwörtern")</div>
        <div class="card-body">
            <p class="small text-muted">@Html.Raw(F("PaCo prüft auf dem PC <strong>lokal</strong>, ob bestimmte Wörter auftauchen, und meldet nur den Treffer mit kurzem Ausschnitt – sofort aufs Handy, wenn <a href=\"{0}\">Handy-Benachrichtigungen</a> eingerichtet sind.", Url.Page("/Notifications")))</p>
            <div class="form-check form-switch">
                <input asp-for="AlertsEnabled" class="form-check-input" role="switch" />
                <label asp-for="AlertsEnabled" class="form-check-label">@T("Alarme einschalten")</label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="ScanWindowText" class="form-check-input" role="switch" />
                <label asp-for="ScanWindowText" class="form-check-label">@T("Auch sichtbaren Text im aktiven Fenster prüfen (Chats, Webseiten) – sonst nur Fenstertitel und Suchen")</label>
            </div>
            <div class="form-check form-switch mb-3">
                <input asp-for="ShowHelpToChild" class="form-check-input" role="switch" />
                <label asp-for="ShowHelpToChild" class="form-check-label">@T("Bei Suizid-Stichwörtern dem Kind Hilfsangebote anzeigen (Nummer gegen Kummer, TelefonSeelsorge)")</label>
            </div>
            <fieldset class="mb-3">
                <legend class="form-label fs-6 mb-1">@T("Worauf soll PaCo achten?")</legend>
                <div class="row row-cols-1 row-cols-md-2 g-1">
                    @foreach (var cat in Enum.GetValues<AlertCategory>().Where(c => c != AlertCategory.Custom))
                    {
                        <div class="col">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="AlertCategories" value="@cat" id="cat-@cat" checked="@Model.AlertCategories.Contains(cat)" />
                                <label class="form-check-label" for="cat-@cat">@S(AlertKeywords.Label(cat))</label>
                            </div>
                        </div>
                    }
                </div>
            </fieldset>
            <label asp-for="CustomKeywords" class="form-label">@T("Eigene Stichwörter")</label>
            <textarea asp-for="CustomKeywords" class="form-control font-monospace" rows="3" autocapitalize="off" autocorrect="off" spellcheck="false" aria-describedby="kw-help"></textarea>
            <div id="kw-help" class="form-text">@Html.Raw(F("Eins pro Zeile. Ein {0} am Ende findet auch Wortanfänge, z. B. {1}.", "<code>*</code>", "<code>casino*</code>"))</div>
        </div>
    </section>

    <section class="card mb-3" aria-labelledby="sec-general">
        <div class="card-header" id="sec-general"><span class="head-ico" aria-hidden="true"><span class="ico ico-user" aria-hidden="true"></span></span>@T("Allgemein")</div>
        <div class="card-body">
            <div class="mb-3">
                <label asp-for="Name" class="form-label">@T("Name")</label>
                <input asp-for="Name" class="form-control" autocomplete="off" autocapitalize="words" maxlength="60" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ChildLanguage" class="form-label">@T("Sprache am PC des Kindes")</label>
                <select asp-for="ChildLanguage" class="form-select" aria-describedby="lang-help">
                    @foreach (var l in PaCo.Server.Pages.Children.EditModel.LanguageOptions)
                    {
                        <option value="@l.Code" lang="@l.Code">@l.NativeName</option>
                    }
                </select>
                <div id="lang-help" class="form-text">@T("Sperrbildschirm und Hinweise auf dem PC des Kindes erscheinen in dieser Sprache. Zusätzlich werden die Alarm-Stichwörter dieser Sprache geprüft.")</div>
                <span asp-validation-for="ChildLanguage" class="text-danger small"></span>
            </div>
            <div class="form-check form-switch">
                <input asp-for="NotifyChildOnScreenshot" class="form-check-input" role="switch" />
                <label asp-for="NotifyChildOnScreenshot" class="form-check-label">@T("Kind kurz informieren, wenn ein Bildschirmfoto gemacht wird (empfohlen – Vertrauen)")</label>
            </div>
        </div>
    </section>

    <div class="sticky-actions d-flex flex-wrap align-items-center gap-2">
        <button type="submit" class="btn btn-primary btn-lg"><span class="ico ico-check" aria-hidden="true"></span>@T("Speichern")</button>
        <a asp-page="/Dashboard" class="btn btn-link">@T("Abbrechen")</a>
        <span class="small text-muted d-none d-sm-inline">@T("Online-PCs übernehmen die Regeln innerhalb von 30 Sekunden.")</span>
    </div>
</form>

<form method="post" asp-page-handler="Delete" asp-route-id="@Model.Id" class="mt-5 pt-3 border-top">
    <div class="small text-muted mb-2">@T("Kind wird nicht mehr gebraucht? Dabei werden Statistik und Regeln gelöscht, und zugeordnete Windows-Konten werden nicht mehr überwacht.")</div>
    <button class="btn btn-sm btn-outline-danger" data-confirm="@F("{0} wirklich löschen? Statistik und Regeln gehen verloren.", Model.Name)"><span class="ico ico-trash" aria-hidden="true"></span>@T("Kind löschen")</button>
</form>

@page
@model PaCo.Server.Pages.Children.IndexModel
@{ ViewData["Title"] = "Kinder"; }

<h1 class="h3 mb-3">Kinder</h1>

<div class="card mb-3">
    <div class="list-group list-group-flush">
        @foreach (var c in Model.Children)
        {
            var accs = Model.Accounts[c.Id].ToList();
            <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                <div>
                    <div class="fw-semibold fs-5">@c.Name</div>
                    <div class="small text-muted">
                        @if (accs.Count == 0) { <span>Noch keinem Windows-Konto zugeordnet</span> }
                        else { @string.Join(", ", accs.Select(a => $"{a.UserName} auf {a.Device?.Name}")) }
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-page="./Stats" asp-route-id="@c.Id" class="btn btn-outline-secondary">Statistik</a>
                    <a asp-page="./Edit" asp-route-id="@c.Id" class="btn btn-primary">Regeln</a>
                </div>
            </div>
        }
        @if (Model.Children.Count == 0)
        {
            <div class="list-group-item text-muted py-3">Noch keine Kinder. Sie werden automatisch angelegt, wenn du PaCo auf einem PC installierst – oder hier vorab.</div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">Kind hinzufügen</div>
    <div class="card-body">
        <form method="post" class="row g-2">
            <div class="col-sm-8">
                <input asp-for="NewName" class="form-control" placeholder="Vorname" />
                <span asp-validation-for="NewName" class="text-danger small"></span>
            </div>
            <div class="col-sm-4">
                <button class="btn btn-primary w-100">Anlegen</button>
            </div>
        </form>
    </div>
</div>

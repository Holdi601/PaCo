@page
@model PaCo.Server.Pages.Children.IndexModel
@{ ViewData["Title"] = "Kinder"; }

<div class="mb-3">
    <h1 class="h3 page-title mb-1">Kinder</h1>
    <p class="text-muted mb-0">Hier legst du pro Kind fest, wie lange und wann es an den PC darf.</p>
</div>

<div class="card mb-4">
    <div class="list-group list-group-flush">
        @foreach (var c in Model.Children)
        {
            var accs = Model.Accounts[c.Id].ToList();
            <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                <div class="min-w-0">
                    <div class="fw-semibold fs-5">@c.Name @if (c.Paused) { <span class="pill pill-muted ms-1">pausiert</span> }</div>
                    <div class="small text-muted">
                        @if (accs.Count == 0) { <span>Noch keinem Windows-Konto zugeordnet – <a asp-page="/Devices/Index">unter Geräte zuordnen</a></span> }
                        else { @string.Join(", ", accs.Select(a => $"{a.UserName} auf {a.Device?.Name}")) }
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a asp-page="./Edit" asp-route-id="@c.Id" class="btn btn-primary">Regeln<span class="visually-hidden"> für @c.Name</span></a>
                    <a asp-page="./Stats" asp-route-id="@c.Id" class="btn btn-outline-secondary">Statistik<span class="visually-hidden"> für @c.Name</span></a>
                </div>
            </div>
        }
        @if (Model.Children.Count == 0)
        {
            <div class="list-group-item py-4">
                <div class="fw-semibold mb-1">Noch keine Kinder</div>
                <p class="text-muted mb-3">Am einfachsten installierst du PaCo auf dem PC des Kindes – die Kinder werden dabei automatisch angelegt. Du kannst ein Kind aber auch schon vorab unten anlegen.</p>
                <a asp-page="/Devices/Index" class="btn btn-primary">PC hinzufügen</a>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header">Kind von Hand anlegen</div>
    <div class="card-body">
        <p class="small text-muted">Meist nicht nötig. Danach unter <strong>Geräte</strong> das Windows-Konto des Kindes zuordnen.</p>
        <form method="post" class="row g-2">
            <div class="col-sm-8">
                <label asp-for="NewName" class="form-label visually-hidden">Vorname des Kindes</label>
                <input asp-for="NewName" class="form-control" placeholder="Vorname des Kindes" autocomplete="off" autocapitalize="words" maxlength="60" />
                <span asp-validation-for="NewName" class="text-danger small"></span>
            </div>
            <div class="col-sm-4">
                <button class="btn btn-outline-primary w-100">Anlegen</button>
            </div>
        </form>
    </div>
</div>

@page "{id:guid}"
@model PaCo.Server.Pages.Children.StatsModel
@{
    ViewData["Title"] = F("Statistik {0}", Model.Child.Name);
    var max = Math.Max(1, Model.Last14.Max(x => Math.Max(x.Seconds, x.LimitSeconds ?? 0)));
    var tz = Model.Tz;
}

<div class="page-head">
    <div class="page-head-main">
        <span class="page-icon" aria-hidden="true"><span class="ico ico-chart" aria-hidden="true"></span></span>
        <div class="min-w-0">
            <div class="stat-label">@T("Statistik")</div>
            <h1 class="h3 mb-0 page-title">@Model.Child.Name</h1>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Child.Id" class="btn btn-outline-secondary btn-sm"><span class="ico ico-sliders" aria-hidden="true"></span>@T("Regeln")</a>
        <a asp-page="/Dashboard" class="btn btn-outline-secondary btn-sm back-link"><span class="ico ico-back" aria-hidden="true"></span>@T("Übersicht")</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-5 order-2 order-lg-1">
        <div class="card h-100">
            <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-calendar" aria-hidden="true"></span></span>@T("Letzte 14 Tage") <span class="visually-hidden">@T("(Tag antippen für Details)")</span><span class="text-muted fw-normal small">· @F("Ø 7 Tage: {0}", Format.Duration(Model.WeekAverage))</span></div>
            <div class="list-group list-group-flush">
                @foreach (var d in Model.Last14)
                {
                    var over = d.LimitSeconds is { } l && d.Seconds > l;
                    <a asp-route-id="@Model.Child.Id" asp-route-day="@d.Day.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                       class="list-group-item list-group-item-action @(d.Day == Model.Day ? "active" : "")" aria-current="@(d.Day == Model.Day ? "date" : null)">
                        <div class="day-bar small">
                            <span class="day-name">@Format.ShortDayName(d.Day.DayOfWeek), @Format.DayMonth(d.Day)</span>
                            <progress class="w-100 @(over ? "is-over" : "")" max="@max" value="@d.Seconds" aria-hidden="true"></progress>
                            <span class="day-val @(over && d.Day != Model.Day ? "status-warn" : "")">@Format.Duration(d.Seconds)</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-7 order-1 order-lg-2">
        <div class="card mb-3">
            <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-clock" aria-hidden="true"></span></span>@(Model.Day == Model.Today ? T("Heute") : Model.Day.ToString("D"))</div>
            <div class="card-body">
                <div class="big-number">@Format.Duration(Model.DayTotal)</div>
                @if (Model.DayBonus > 0)
                {
                    <div class="small text-muted">@F("davon {0} Zusatzzeit", Format.Duration(Model.DayBonus))</div>
                }
                @if (Model.GroupUsage.Count > 0)
                {
                    <ul class="list-unstyled small mt-3 mb-0">
                        @foreach (var (grp, sec) in Model.GroupUsage)
                        {
                            <li class="d-flex justify-content-between gap-2 py-1">
                                <span>@grp.Name</span>
                                <span class="text-muted text-end">
                                    @if (grp.Kind == TimeGroupKind.Free) { @F("{0} · zählt nicht als PC-Zeit", Format.Duration(sec)) }
                                    else if (grp.MinutesPerDay is { } lim) { @F("{0} von {1}", Format.Duration(sec), Format.Duration(lim * 60L)) }
                                    else { @Format.Duration(sec) }
                                </span>
                            </li>
                        }
                    </ul>
                }
                @if (Model.Apps.Count == 0)
                {
                    <p class="text-muted mt-3 mb-0">@T("An diesem Tag wurde der PC nicht benutzt.")</p>
                }
                else
                {
                    var appMax = Math.Max(1, Model.Apps[0].Seconds);
                    <table class="table table-sm mt-3 mb-0">
                        <thead><tr><th>@T("Programm") <span class="fw-normal text-muted small">@T("(Programmname zum Sperren)")</span></th><th class="text-end">@T("Zeit")</th></tr></thead>
                        <tbody>
                            @foreach (var a in Model.Apps)
                            {
                                <tr>
                                    <td class="app-row">
                                        <div>@a.Name <span class="text-muted small">(@a.Process)</span>
                                            @if (Model.Blocked.Contains(a.Process)) { <span class="badge text-bg-danger ms-1">@T("Programm gesperrt")</span> }
                                        </div>
                                        <progress class="w-100" max="@appMax" value="@a.Seconds" aria-hidden="true"></progress>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <div>@Format.Duration(a.Seconds)</div>
                                        @if (PaCo.Server.Pages.Children.StatsModel.IsManagedOnRulesPage(a.Process))
                                        {
                                            <a class="small" asp-page="./Edit" asp-route-id="@Model.Child.Id" asp-fragment="sec-apps">@T("Regeln")</a>
                                        }
                                        else
                                        {
                                            <form method="post" asp-page-handler="ToggleApp" asp-route-id="@Model.Child.Id" asp-route-day="@Model.Day.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" class="d-inline">
                                                <input type="hidden" name="app" value="@a.Process" />
                                                @if (Model.Blocked.Contains(a.Process))
                                                {
                                                    <button class="btn btn-sm btn-outline-success mt-1" data-confirm="@F("„{0}“ wieder erlauben?", a.Name)">@T("Programm erlauben")</button>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-danger mt-1" data-confirm="@F("„{0}“ sperren? Das Programm wird auf dem PC sofort geschlossen.", a.Name)">@T("Programm sperren")</button>
                                                }
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-list" aria-hidden="true"></span></span>@T("Ereignisse (14 Tage)")</div>
            <div class="list-group list-group-flush small event-list">
                @foreach (var e in Model.Events)
                {
                    <div class="list-group-item">
                        <span class="text-muted">@Format.DayMonthTime(TimeZoneInfo.ConvertTime(e.TimeUtc, tz))</span>
                        · <strong>@PaCo.Server.Pages.Children.StatsModel.EventText(e.Kind)</strong>
                        · @e.Text()
                        <span class="text-muted">(@Model.DeviceNames.GetValueOrDefault(e.DeviceId))</span>
                    </div>
                }
                @if (Model.Events.Count == 0)
                {
                    <div class="list-group-item text-muted">@T("Keine besonderen Ereignisse in den letzten 14 Tagen.")</div>
                }
            </div>
        </div>
    </div>
</div>
@if (Model.Day == Model.Today)
{
    <div data-autorefresh="30"></div>
}

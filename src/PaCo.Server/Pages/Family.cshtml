@page
@model PaCo.Server.Pages.FamilyModel
@{ ViewData["Title"] = T("Familie"); }

<div class="page-head">
    <div class="page-head-main">
        <span class="page-icon is-warm" aria-hidden="true"><span class="ico ico-heart" aria-hidden="true"></span></span>
        <div class="min-w-0">
            <div class="stat-label">@T("Familie")</div>
            <h1 class="h3 page-title">@T("Eltern & Erziehungsberechtigte")</h1>
            <p class="text-muted mb-0">@T("Alle hier haben die gleichen Rechte: Regeln ändern, Zeit geben, sperren, Alarme sehen.")</p>
            <p class="small mt-2 mb-0">@Html.Raw(F("Alarme aufs Handy richtet jedes Elternteil selbst ein: <a href=\"{0}\">Handy-Benachrichtigungen</a>.", Html.Encode(Url.Page("/Notifications"))))</p>
        </div>
    </div>
</div>

@if (Model.InviteLink is not null)
{
    <div class="alert alert-info" role="status">
        <div class="fw-semibold mb-1">@F("Einladungslink für {0}", Model.InviteFor)</div>
        <div class="small mb-2">@T("Jetzt kopieren und z. B. per Messenger schicken – der Link wird nur dieses eine Mal angezeigt. 7 Tage gültig, nur einmal benutzbar. Damit legt die Person ihr Passwort fest und richtet die Authenticator-App ein.")</div>
        <div class="input-group">
            <input id="invite-link" class="form-control font-monospace small" value="@Model.InviteLink" readonly aria-label="@T("Einladungslink")" />
            <button class="btn btn-primary" data-copy="#invite-link" type="button"><span class="ico ico-copy" aria-hidden="true"></span>@T("Kopieren")</button>
            <button class="btn btn-outline-primary" data-share="#invite-link" data-share-title="@T("Einladung zu PaCo")" type="button" hidden><span class="ico ico-send" aria-hidden="true"></span>@T("Teilen")</button>
        </div>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-users" aria-hidden="true"></span></span>@T("Mitglieder")</div>
            <ul class="list-group list-group-flush">
                @foreach (var p in Model.Parents)
                {
                    <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                        <div class="person">
                            <div class="child-avatar avatar-sm av-@(string.IsNullOrEmpty(p.DisplayName) ? 0 : p.DisplayName[0] % 6)" aria-hidden="true">@(string.IsNullOrEmpty(p.DisplayName) ? "?" : p.DisplayName[..1].ToUpperInvariant())</div>
                            <div class="min-w-0">
                            <div class="fw-semibold">@p.DisplayName @if (p.Id == Model.MyId) { <span class="text-muted small">@T("(du)")</span> }</div>
                            <div class="small text-muted">@p.Email · @(p.InvitePending ? T("Einladung noch nicht angenommen") : F("zuletzt angemeldet {0}", Format.Ago(p.LastLoginUtc, Model.Now)))</div>
                            </div>
                        </div>
                        @if (p.Id != Model.MyId)
                        {
                            <div class="d-flex gap-2">
                                @if (p.InvitePending)
                                {
                                    <form method="post" asp-page-handler="NewLink">
                                        <input type="hidden" name="userId" value="@p.Id" />
                                        <button class="btn btn-sm btn-outline-secondary" data-confirm="@F("Neuen Einladungslink für {0} erstellen? Der alte Link funktioniert dann nicht mehr.", p.DisplayName)"><span class="ico ico-link" aria-hidden="true"></span>@T("Neuer Link")</button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="Remove">
                                    <input type="hidden" name="userId" value="@p.Id" />
                                    <button class="btn btn-sm btn-outline-danger" data-confirm="@F("{0} wirklich aus der Familie entfernen? Das Konto wird gelöscht.", p.DisplayName)"><span class="ico ico-user-minus" aria-hidden="true"></span>@T("Entfernen")</button>
                                </form>
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-user-plus" aria-hidden="true"></span></span>@T("Weiteres Elternteil einladen")</div>
            <div class="card-body">
                <p class="small text-muted">@T("Z. B. Papa, Oma oder eine andere Bezugsperson. Es wird keine E-Mail verschickt – du bekommst einen Link, den du selbst weiterschickst.")</p>
                <form method="post" asp-page-handler="Invite">
                    <div class="mb-3">
                        <label asp-for="InviteName" class="form-label">@T("Name")</label>
                        <input asp-for="InviteName" class="form-control" placeholder="@T("z. B. Papa")" autocomplete="off" autocapitalize="words" />
                        <span asp-validation-for="InviteName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="InviteEmail" class="form-label">@T("E-Mail-Adresse")</label>
                        <input asp-for="InviteEmail" class="form-control" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="invite-email-help" />
                        <div id="invite-email-help" class="form-text">@T("Damit meldet sich die Person später an.")</div>
                        <span asp-validation-for="InviteEmail" class="text-danger small"></span>
                    </div>
                    <button class="btn btn-primary w-100"><span class="ico ico-link" aria-hidden="true"></span>@T("Einladungslink erstellen")</button>
                </form>
                <div class="form-text mt-2">@T("Die eingeladene Person gehört danach zu eurer Familie und sieht nur eure Kinder.")</div>
            </div>
        </div>
    </div>
</div>

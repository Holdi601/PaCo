@page
@model ErrorModel
@{
    ViewData["Title"] = "Fehler";
}

<div class="card mt-4">
    <div class="card-body p-4">
        <h1 class="h4">Da ist leider etwas schiefgelaufen</h1>
        <p>Bitte versuch es gleich noch einmal. Wenn der Fehler bleibt, sag der Person Bescheid, die PaCo für euch betreibt.</p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="/Index" class="btn btn-primary">Zur Startseite</a>
        </div>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted mt-3 mb-0">Fehlernummer für den Betreiber: <code>@Model.RequestId</code></p>
        }
    </div>
</div>

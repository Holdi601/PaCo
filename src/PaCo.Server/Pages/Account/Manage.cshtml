@page
@using PaCo.Shared.I18n
@model PaCo.Server.Pages.Account.ManageModel
@{ ViewData["Title"] = T("Mein Konto"); }

<div class="page-head">
    <div class="page-head-main">
        <span class="page-icon" aria-hidden="true"><span class="ico ico-user" aria-hidden="true"></span></span>
        <div class="min-w-0">
            <h1 class="h3 mb-0 page-title">@T("Mein Konto")</h1>
        </div>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-user" aria-hidden="true"></span></span>@T("Profil")</div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label for="account-email" class="form-label">@T("E-Mail (zum Anmelden)")</label>
                        <input id="account-email" class="form-control" value="@Model.Email" disabled />
                    </div>
                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label">@T("Anzeigename")</label>
                        <input asp-for="DisplayName" class="form-control" autocomplete="name" autocapitalize="words" aria-describedby="name-help" />
                        <div id="name-help" class="form-text">@T("So sehen dich die anderen Eltern.")</div>
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary"><span class="ico ico-check" aria-hidden="true"></span>@T("Speichern")</button>
                        <a asp-page="./ChangePassword" class="btn btn-outline-secondary"><span class="ico ico-lock" aria-hidden="true"></span>@T("Passwort ändern")</a>
                    </div>
                </form>
                @* Language of the website (and, by majority of the family's parents, of the phone notifications). *@
                <form method="post" asp-page="/Language" class="mt-4 pt-3 border-top">
                    <input type="hidden" name="returnUrl" value="/Account/Manage" />
                    <label for="account-lang" class="form-label"><span class="ico ico-globe me-2" aria-hidden="true"></span>@T("Sprache")</label>
                    <div class="d-flex flex-wrap gap-2">
                        <select id="account-lang" name="lang" class="form-select w-auto" data-autosubmit aria-describedby="lang-help">
                            @foreach (var l in Languages.All)
                            {
                                <option value="@l.Code" lang="@l.Code" selected="@(l.Code == Model.AccountLanguage)">@l.NativeName</option>
                            }
                        </select>
                        <noscript><button type="submit" class="btn btn-outline-secondary">@T("Übernehmen")</button></noscript>
                    </div>
                    <div id="lang-help" class="form-text">@T("Wird in deinem Konto gespeichert und gilt für die ganze Website.")</div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-shield-check" aria-hidden="true"></span></span>@T("Sicherheit")</div>
            <div class="card-body">
                <p>@T("Zwei-Faktor-Anmeldung:") <span class="pill pill-ok">@T("aktiv")</span><br />
                   @T("Übrige Notfall-Codes:") <strong class="@(Model.RecoveryCodesLeft <= 2 ? "status-warn" : "")">@Model.RecoveryCodesLeft</strong></p>
                @if (Model.RecoveryCodesLeft <= 2)
                {
                    <p class="small status-warn">@T("Nur noch wenige Notfall-Codes übrig – erstelle am besten neue und schreib sie auf.")</p>
                }
                <div class="d-flex flex-wrap gap-2">
                    <a asp-page="./SetupAuthenticator" class="btn btn-outline-secondary"><span class="ico ico-phone" aria-hidden="true"></span>@T("Neues Handy einrichten")</a>
                    <form method="post" asp-page-handler="RecoveryCodes" class="d-flex flex-wrap gap-2 align-items-center">
                        <input type="password" name="currentPassword" class="form-control form-control-sm w-auto" required autocomplete="current-password" placeholder="@T("Aktuelles Passwort")" aria-label="@T("Aktuelles Passwort")" />
                        <button type="submit" class="btn btn-outline-secondary" data-confirm="@T("Neue Notfall-Codes erstellen? Die alten Codes funktionieren danach nicht mehr.")"><span class="ico ico-key" aria-hidden="true"></span>@T("Neue Notfall-Codes")</button>
                    </form>
                    <form method="post" asp-page-handler="LogoutEverywhere">
                        <button type="submit" class="btn btn-outline-danger" data-confirm="@T("Auf allen Geräten abmelden – auch hier? Danach musst du dich überall neu anmelden.")"><span class="ico ico-logout" aria-hidden="true"></span>@T("Überall abmelden")</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    @if (User.HasClaim(c => c.Type == PaCoClaims.Family))
    {
        <div class="col-12">
            <div class="card">
                <div class="card-header"><span class="head-ico" aria-hidden="true"><span class="ico ico-sliders" aria-hidden="true"></span></span>@T("Weitere Einstellungen")</div>
                <div class="list-group list-group-flush">
                    <a asp-page="/Notifications" class="list-group-item list-group-item-action py-3 link-row">
                        <span class="device-ico" aria-hidden="true"><span class="ico ico-phone" aria-hidden="true"></span></span>
                        <div class="min-w-0 flex-grow-1">
                        <div class="fw-semibold">@T("Handy-Benachrichtigungen")</div>
                        <div class="small text-muted">@T("Alarme sofort aufs Handy bekommen (App ntfy einrichten)")</div>
                        </div>
                        <span class="ico ico-chevron-right text-muted" aria-hidden="true"></span>
                    </a>
                    <a asp-page="/Family" class="list-group-item list-group-item-action py-3 link-row">
                        <span class="device-ico" aria-hidden="true"><span class="ico ico-heart" aria-hidden="true"></span></span>
                        <div class="min-w-0 flex-grow-1">
                        <div class="fw-semibold">@T("Familie & Eltern einladen")</div>
                        <div class="small text-muted">@T("Wer außer dir noch Zugriff hat – und weitere Eltern einladen")</div>
                        </div>
                        <span class="ico ico-chevron-right text-muted" aria-hidden="true"></span>
                    </a>
                </div>
            </div>
        </div>
    }
</div>

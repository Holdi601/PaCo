@page
@model PaCo.Server.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = T("Passwort ändern"); }

<div class="auth-shell">
    <div class="auth-art" aria-hidden="true">
        <div class="auth-brand"><partial name="_Logo" model="@("auth")" /><span class="wordmark">Pa<span class="wordmark-co">Co</span></span></div>
        <partial name="_ArtHero" />
    </div>
    <div class="card auth-card">
        <div class="card-body p-4">
            <h1 class="h4 mb-2">@T("Passwort ändern")</h1>
            @if (Model.Forced)
            {
                <p class="text-muted">@T("Willkommen! Bitte ersetze das vorläufige Passwort durch ein eigenes. Danach richtest du die Authenticator-App ein.")</p>
            }
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <form method="post">
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">@(Model.Forced ? T("Vorläufiges Passwort") : T("Aktuelles Passwort"))</label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">@T("Neues Passwort")</label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="pw-rules" />
                    <div id="pw-rules" class="form-text">@T("Mindestens 12 Zeichen, mit Groß- und Kleinbuchstaben und einer Ziffer. Tipp: ein kurzer Satz wie „Sommer-Ferien-2026“.")</div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">@T("Neues Passwort wiederholen")</label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">@T("Speichern")</button>
                @if (!Model.Forced)
                {
                    <a asp-page="./Manage" class="btn btn-link w-100 mt-1">@T("Abbrechen")</a>
                }
            </form>
        </div>
    </div>
</div>

@page
@model PaCo.Server.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Passwort ändern"; }

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card mt-4">
            <div class="card-body p-4">
                <h1 class="h4 mb-2">Passwort ändern</h1>
                @if (Model.Forced)
                {
                    <p class="text-muted">Willkommen! Bitte ersetze das vorläufige Passwort durch ein eigenes. Danach richtest du die Authenticator-App ein.</p>
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">@(Model.Forced ? "Vorläufiges Passwort" : "Aktuelles Passwort")</label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Neues Passwort</label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <div class="form-text">Mindestens 12 Zeichen, mit Groß- und Kleinbuchstaben und einer Ziffer.</div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Neues Passwort wiederholen</label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Speichern</button>
                </form>
            </div>
        </div>
    </div>
</div>

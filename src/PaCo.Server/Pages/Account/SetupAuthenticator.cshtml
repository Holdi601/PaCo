@page
@model PaCo.Server.Pages.Account.SetupAuthenticatorModel
@{ ViewData["Title"] = T("Zwei-Faktor-Anmeldung"); }

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="card mt-2 setup-card">
            <div class="card-body p-4">
                @if (Model.RecoveryCodes is not null)
                {
                    <div class="done-badge mb-3" aria-hidden="true"><span class="ico ico-shield-check" aria-hidden="true"></span></div>
                    <h1 class="h4">@T("Fertig – 2FA ist aktiv")</h1>
                    <p>@Html.Raw(F("Schreib dir diese {0}Notfall-Codes{1} auf und bewahre sie sicher auf (nicht auf dem Handy!). Falls das Handy verloren geht, kommst du damit noch einmal hinein. Jeder Code funktioniert nur einmal.", "<strong>", "</strong>"))</p>
                    <div class="recovery-codes alert alert-warning">
                        @foreach (var c in Model.RecoveryCodes.Split('\n'))
                        {
                            <div>@c</div>
                        }
                    </div>
                    <a asp-page="/Index" class="btn btn-primary" data-confirm="@T("Hast du die Notfall-Codes aufgeschrieben? Sie werden nicht noch einmal angezeigt.")"><span class="ico ico-check" aria-hidden="true"></span>@T("Ich habe die Codes notiert – weiter")</a>
                }
                else if (Model.AlreadyEnabled)
                {
                    <div class="done-badge mb-3" aria-hidden="true"><span class="ico ico-shield-check" aria-hidden="true"></span></div>
                    <h1 class="h4">@T("Zwei-Faktor-Anmeldung ist aktiv")</h1>
                    <p>@T("Neues Handy? Dann hier neu einrichten. Der alte Eintrag in der App funktioniert danach nicht mehr.")</p>
                    <div class="d-flex flex-wrap gap-2">
                        <form method="post" asp-page-handler="Reset">
                            <button type="submit" class="btn btn-outline-danger" data-confirm="@T("Authenticator neu einrichten? Der bisherige Eintrag in der App funktioniert danach nicht mehr.")"><span class="ico ico-refresh" aria-hidden="true"></span>@T("Authenticator neu einrichten")</button>
                        </form>
                        <a asp-page="./Manage" class="btn btn-link"><span class="ico ico-back" aria-hidden="true"></span>@T("Zurück zu Mein Konto")</a>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <span class="page-icon" aria-hidden="true"><span class="ico ico-shield-check" aria-hidden="true"></span></span>
                        <h1 class="h4 mb-0">@T("Authenticator-App einrichten")</h1>
                    </div>
                    <p class="text-muted">@T("Zum Schutz deines Kontos ist eine zweite Bestätigung per Handy Pflicht.")</p>
                    <ol class="steps">
                        <li class="mb-2">@Html.Raw(F("Installiere {0} (oder Microsoft Authenticator) auf deinem Handy.", "<strong>Google Authenticator</strong>"))</li>
                        <li class="mb-2">
                            <span class="d-md-none"><strong>@T("Du bist gerade am Handy?")</strong> @T("Dann tippe hier – die App öffnet sich und übernimmt PaCo:")
                                <a href="@Model.AuthenticatorUri" class="btn btn-primary d-flex my-2"><span class="ico ico-phone" aria-hidden="true"></span>@T("In Authenticator-App übernehmen")</a>
                                @T("Am PC kannst du stattdessen den QR-Code scannen:")</span>
                            <span class="d-none d-md-inline">@Html.Raw(F("Tippe in der App auf {0} → {1} und scanne diesen Code:", "<strong>+</strong>", "<strong>" + Html.Encode(T("QR-Code scannen")) + "</strong>"))</span>
                            <div class="qr my-3"><img src="@Model.QrDataUri" alt="@T("QR-Code für die Authenticator-App")" /></div>
                            <div class="small text-muted">@T("Scannen klappt nicht? Schlüssel manuell eingeben:") <code>@Model.SharedKey</code>
                                <input type="hidden" id="totp-key" value="@Model.SharedKey.Replace(" ", "")" />
                                <button type="button" class="btn btn-sm btn-link p-0 ms-1 align-baseline" data-copy="#totp-key">@T("Kopieren")</button>
                            </div>
                        </li>
                        <li class="mb-2"><label for="Code">@T("Gib den 6-stelligen Code ein, den die App jetzt anzeigt:")</label></li>
                    </ol>
                    <form method="post" class="row g-2">
                        <div class="col-sm-6">
                            <input asp-for="Code" class="form-control form-control-lg text-center code-input" inputmode="numeric" maxlength="7" autocomplete="one-time-code" placeholder="123456" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <button type="submit" class="btn btn-primary btn-lg w-100"><span class="ico ico-check" aria-hidden="true"></span>@T("Bestätigen")</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

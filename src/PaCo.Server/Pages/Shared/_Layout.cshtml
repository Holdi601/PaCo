@using System.Security.Claims
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(PaCoRoles.SuperAdmin);
    var hasFamily = User.HasClaim(c => c.Type == PaCoClaims.Family);
    var onboarded = User.FindFirstValue(PaCoClaims.TwoFactor) == "1" && User.FindFirstValue(PaCoClaims.MustChangePassword) == "0";
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] – PaCo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md navbar-dark bg-paco mb-3">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-page="/Index">PaCo</a>
            @if (signedIn && onboarded)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="Menü">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto">
                        @if (hasFamily)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Dashboard">Übersicht</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Children/Index">Kinder</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Devices/Index">Geräte</a></li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Index">Verwaltung</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-page="/Account/Manage">@User.FindFirstValue(PaCoClaims.DisplayName)</a></li>
                        <li class="nav-item">
                            <form method="post" asp-page="/Account/Logout" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link">Abmelden</button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else if (signedIn)
            {
                <form method="post" asp-page="/Account/Logout" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-light">Abmelden</button>
                </form>
            }
        </div>
    </nav>
    <main class="container pb-5">
        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success" role="status">@msg</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger" role="alert">@err</div>
        }
        @RenderBody()
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@using System.Security.Claims
@using PaCo.Shared.I18n
@inject FamilyInfo FamilyInfo
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(PaCoRoles.SuperAdmin);
    var hasFamily = User.HasClaim(c => c.Type == PaCoClaims.Family);
    var onboarded = User.FindFirstValue(PaCoClaims.TwoFactor) == "1" && User.FindFirstValue(PaCoClaims.MustChangePassword) == "0";
    var path = Context.Request.Path.Value ?? "";
    bool IsAt(params string[] prefixes) => prefixes.Any(p => path.StartsWith(p, StringComparison.OrdinalIgnoreCase));
    string Active(params string[] prefixes) => IsAt(prefixes) ? "active" : "";
    string? Current(params string[] prefixes) => IsAt(prefixes) ? "page" : null;
    var unreadAlerts = signedIn && onboarded && hasFamily ? await FamilyInfo.UnreadAlertsAsync() : 0;
    var settingsPages = new[] { "/Family", "/Notifications", "/Account" };
    var lang = Ui.Lang;
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@lang" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f6fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b101b" media="(prefers-color-scheme: dark)" />
    <title>@ViewData["Title"] – PaCo</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" sizes="any" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@* Texts for site.js (no inline scripts allowed – CSP). *@
<body data-txt-copied="@T("Kopiert ✓")" data-txt-day-copied="@T("Übertragen ✓ – Speichern nicht vergessen")">
    <a class="visually-hidden-focusable skip-link" href="#main">@T("Zum Inhalt springen")</a>
    <nav class="navbar navbar-expand-lg paco-nav mb-4" aria-label="@T("Hauptmenü")">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">
                <partial name="_Logo" model="@("nav")" />
                <span class="wordmark">Pa<span class="wordmark-co">Co</span></span>
            </a>
            <div class="d-flex align-items-center gap-2 order-lg-last">
                @if (unreadAlerts > 0)
                {
                    @* On phones the menu is collapsed – keep new alarms visible next to the menu button. *@
                    <a asp-page="/Alerts" class="btn btn-sm btn-danger d-lg-none text-nowrap nav-alarm" aria-label="@(unreadAlerts == 1 ? T("Einen neuen Alarm ansehen") : F("{0} neue Alarme ansehen", unreadAlerts))"><span class="ico ico-bell" aria-hidden="true"></span>@unreadAlerts</a>
                }
                @if (!(signedIn && onboarded))
                {
                    @* Sign-in and onboarding pages: language choice right at the top. *@
                    <form method="post" asp-page="/Language" class="lang-picker" title="@T("Sprache")">
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <span class="ico ico-globe" aria-hidden="true"></span>
                        <select name="lang" data-autosubmit aria-label="@T("Sprache")">
                            @foreach (var l in Languages.All)
                            {
                                <option value="@l.Code" lang="@l.Code" selected="@(l.Code == lang)">@l.NativeName</option>
                            }
                        </select>
                        <noscript><button type="submit" class="btn btn-sm btn-link p-0">@T("Übernehmen")</button></noscript>
                    </form>
                }
                <button type="button" class="theme-toggle" data-theme-toggle data-mode="auto" aria-label="@T("Farbschema wechseln")"
                        data-label-auto="@T("Auto")" data-label-light="@T("Hell")" data-label-dark="@T("Dunkel")" data-title="@T("Farbschema: {0}")"><span class="theme-label">@T("Auto")</span></button>
                @if (signedIn && onboarded)
                {
                    <button class="navbar-toggler nav-toggle d-lg-none p-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav" aria-expanded="false" aria-label="@T("Menü öffnen")">
                        <span class="ico ico-menu" aria-hidden="true"></span>
                    </button>
                }
            </div>
            @if (signedIn && onboarded)
            {
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto gap-lg-1 mt-2 mt-lg-0">
                        @if (hasFamily)
                        {
                            <li class="nav-item"><a class="nav-link @Active("/Dashboard")" aria-current="@Current("/Dashboard")" asp-page="/Dashboard"><span class="ico ico-home" aria-hidden="true"></span>@T("Übersicht")</a></li>
                            <li class="nav-item"><a class="nav-link @Active("/Children")" aria-current="@Current("/Children")" asp-page="/Children/Index"><span class="ico ico-users" aria-hidden="true"></span>@T("Kinder")</a></li>
                            <li class="nav-item"><a class="nav-link @Active("/Devices")" aria-current="@Current("/Devices")" asp-page="/Devices/Index"><span class="ico ico-laptop" aria-hidden="true"></span>@T("Geräte")</a></li>
                            <li class="nav-item">
                                <a class="nav-link @Active("/Alerts")" aria-current="@Current("/Alerts")" asp-page="/Alerts"><span class="ico ico-bell" aria-hidden="true"></span>@T("Alarme")
                                    @if (unreadAlerts > 0) { <span class="badge rounded-pill bg-danger ms-1">@unreadAlerts<span class="visually-hidden"> @T("neu")</span></span> }
                                </a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item"><a class="nav-link @Active("/Admin")" aria-current="@Current("/Admin")" asp-page="/Admin/Index"><span class="ico ico-shield" aria-hidden="true"></span>@T("Verwaltung")</a></li>
                        }
                    </ul>
                    @* Things that are set up once (phone push, family, own account, language) live together in one menu. *@
                    <ul class="navbar-nav gap-lg-1 me-lg-2 mb-1 mb-lg-0">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @Active(settingsPages)" href="#" id="settings-menu" role="button" data-bs-toggle="dropdown" aria-expanded="false"><span class="ico ico-sliders" aria-hidden="true"></span>@T("Einstellungen")</a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="settings-menu">
                                <li><span class="dropdown-item-text small text-muted">@Html.Raw(F("Angemeldet als {0}", "<strong>" + Html.Encode(User.FindFirstValue(PaCoClaims.DisplayName)) + "</strong>"))</span></li>
                                <li><hr class="dropdown-divider" /></li>
                                @if (hasFamily)
                                {
                                    <li><a class="dropdown-item @Active("/Notifications")" aria-current="@Current("/Notifications")" asp-page="/Notifications"><span class="ico ico-phone" aria-hidden="true"></span>@T("Handy-Benachrichtigungen")</a></li>
                                    <li><a class="dropdown-item @Active("/Family")" aria-current="@Current("/Family")" asp-page="/Family"><span class="ico ico-heart" aria-hidden="true"></span>@T("Familie & Eltern einladen")</a></li>
                                }
                                <li><a class="dropdown-item @Active("/Account")" aria-current="@Current("/Account")" asp-page="/Account/Manage"><span class="ico ico-user" aria-hidden="true"></span>@T("Mein Konto & Passwort")</a></li>
                                <li>
                                    <form method="post" asp-page="/Language" class="dropdown-lang">
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <label for="nav-lang" class="dropdown-lang-label"><span class="ico ico-globe" aria-hidden="true"></span>@T("Sprache")</label>
                                        <select id="nav-lang" name="lang" class="form-select form-select-sm" data-autosubmit>
                                            @foreach (var l in Languages.All)
                                            {
                                                <option value="@l.Code" lang="@l.Code" selected="@(l.Code == lang)">@l.NativeName</option>
                                            }
                                        </select>
                                        <noscript><button type="submit" class="btn btn-sm btn-outline-secondary">@T("Übernehmen")</button></noscript>
                                    </form>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-page="/Account/Logout">
                                        <button type="submit" class="dropdown-item"><span class="ico ico-logout" aria-hidden="true"></span>@T("Abmelden")</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            }
            else if (signedIn)
            {
                <form method="post" asp-page="/Account/Logout" class="d-inline order-lg-last ms-2">
                    <button type="submit" class="btn btn-sm btn-outline-secondary"><span class="ico ico-logout" aria-hidden="true"></span>@T("Abmelden")</button>
                </form>
            }
        </div>
    </nav>
    <main id="main" class="container pb-5" tabindex="-1">
        @if (TempData["Message"] is string msg)
        {
            <div class="alert alert-success alert-dismissible fade show" role="status">
                @msg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T("Meldung schließen")"></button>
            </div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@T("Meldung schließen")"></button>
            </div>
        }
        @RenderBody()
    </main>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
